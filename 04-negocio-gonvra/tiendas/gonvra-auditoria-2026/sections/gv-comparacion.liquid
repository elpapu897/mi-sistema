{{ 'gv-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gv-scripts.js' | asset_url }}" defer></script>

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: radial-gradient(135% 90% at 50% 0%, #e6f4ee 0%, #d8ebf2 46%, {{ section.settings.fondo }} 100%);
  }
  #shopify-section-{{ section.id }} .gv-h2 { font-size: {{ section.settings.title_size }}px; }
  #shopify-section-{{ section.id }} .gv-cmp { max-width: 760px; margin: 0 auto; background:#fff; border-radius:22px; overflow:hidden; box-shadow:0 24px 55px rgba(14,43,37,.17); border:1px solid #d5e7df; position:relative; }
  #shopify-section-{{ section.id }} .gv-cmp::before { content:''; display:block; height:6px; background:linear-gradient(90deg, {{ section.settings.brand_color }}, #1f9d70); }
  #shopify-section-{{ section.id }} .gv-cmp__row { display:grid; grid-template-columns: 1.6fr .9fr .9fr; align-items:center; border-top:1px solid #eef3f1; }
  #shopify-section-{{ section.id }} .gv-cmp__row:first-child { border-top:0; }
  #shopify-section-{{ section.id }} .gv-cmp__head { background:{{ section.settings.head_fondo }}; }
  #shopify-section-{{ section.id }} .gv-cmp__head .gv-cmp__c { font-weight:800; color:#0e2b25; padding:16px 10px; }
  #shopify-section-{{ section.id }} .gv-cmp__c { padding:14px 12px; text-align:center; font-weight:700; font-size:14px; }
  #shopify-section-{{ section.id }} .gv-cmp__f { text-align:left; padding:14px 16px; font-weight:600; color:#243b36; font-size:15px; }
  #shopify-section-{{ section.id }} .gv-cmp__brand { color:{{ section.settings.brand_color }}; }
  #shopify-section-{{ section.id }} .gv-cmp__yes { color:#1f9d70; }
  #shopify-section-{{ section.id }} .gv-cmp__no { color:#c94b4b; }
  #shopify-section-{{ section.id }} .gv-cmp__ic { width:22px; height:22px; display:inline-block; vertical-align:middle; }
  @media (max-width:520px){
    #shopify-section-{{ section.id }} .gv-cmp__f { font-size:13.5px; padding:12px 10px; }
    #shopify-section-{{ section.id }} .gv-cmp__c { font-size:12px; padding:12px 4px; }
  }
{%- endstyle -%}

{%- assign yes_ic = '<svg class="gv-cmp__ic gv-cmp__yes" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M20 6 9 17l-5-5"/></svg>' -%}
{%- assign no_ic = '<svg class="gv-cmp__ic gv-cmp__no" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.6" stroke-linecap="round" stroke-linejoin="round"><path d="M18 6 6 18"/><path d="m6 6 12 12"/></svg>' -%}

<section class="gv-section">
  <div class="gv-container">
    {%- if section.settings.title != blank -%}
      <div class="gv-head gv-reveal">
        {%- if section.settings.eyebrow != blank -%}<span class="gv-eyebrow gv-center">{{ section.settings.eyebrow }}</span>{%- endif -%}
        <h2 class="gv-h2">{{ section.settings.title }}</h2>
        {%- if section.settings.subtitle != blank -%}<p class="gv-ba__sub" style="text-align:center;color:#5c7a72;max-width:560px;margin:8px auto 0;">{{ section.settings.subtitle }}</p>{%- endif -%}
      </div>
    {%- endif -%}

    <div class="gv-cmp gv-reveal">
      <div class="gv-cmp__row gv-cmp__head">
        <div class="gv-cmp__f">&nbsp;</div>
        <div class="gv-cmp__c gv-cmp__brand">{{ section.settings.col1 }}</div>
        <div class="gv-cmp__c">{{ section.settings.col2 }}</div>
      </div>
      {%- for block in section.blocks -%}
        <div class="gv-cmp__row" {{ block.shopify_attributes }}>
          <div class="gv-cmp__f">{{ block.settings.texto | replace: '7 días','10 días' | replace: '30 días','10 días' }}</div>
          <div class="gv-cmp__c">{% if block.settings.gonvra %}{{ yes_ic }}{% else %}{{ no_ic }}{% endif %}</div>
          <div class="gv-cmp__c">{% if block.settings.competidor %}{{ yes_ic }}{% else %}{{ no_ic }}{% endif %}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "GV – Comparación",
  "tag": "section",
  "max_blocks": 10,
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "Texto pequeño superior", "default": "Por qué GONVRA" },
    { "type": "text", "id": "title", "label": "Título", "default": "¿Por qué comprar en GONVRA y no en Mercado Libre?" },
    { "type": "range", "id": "title_size", "label": "Tamaño del título (px)", "min": 22, "max": 44, "step": 2, "unit": "px", "default": 32 },
    { "type": "text", "id": "subtitle", "label": "Subtítulo", "default": "La diferencia de comprarle a una tienda especializada en mascotas." },
    { "type": "text", "id": "col1", "label": "Columna 1 (tu tienda)", "default": "GONVRA" },
    { "type": "text", "id": "col2", "label": "Columna 2 (competencia)", "default": "Mercado Libre y otras" },
    { "type": "color", "id": "brand_color", "label": "Color de tu marca", "default": "#2E7FB0" },
    { "type": "color", "id": "head_fondo", "label": "Fondo del encabezado", "default": "#F5FAF8" },
    { "type": "color", "id": "fondo", "label": "Color de fondo de la sección", "default": "#EAF5F0" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 64 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 8 }
  ],
  "blocks": [
    {
      "type": "fila",
      "name": "Fila de comparación",
      "settings": [
        { "type": "text", "id": "texto", "label": "Característica", "default": "Característica" },
        { "type": "checkbox", "id": "gonvra", "label": "GONVRA lo tiene", "default": true },
        { "type": "checkbox", "id": "competidor", "label": "La competencia lo tiene", "default": false }
      ]
    }
  ],
  "presets": [
    {
      "name": "GV – Comparación",
      "blocks": [
        { "type": "fila", "settings": { "texto": "Productos elegidos y revisados uno por uno", "gonvra": true, "competidor": false } },
        { "type": "fila", "settings": { "texto": "Atención personalizada: te asesoramos para tu mascota", "gonvra": true, "competidor": false } },
        { "type": "fila", "settings": { "texto": "Garantía de 10 días directa con la tienda", "gonvra": true, "competidor": false } },
        { "type": "fila", "settings": { "texto": "Especialistas solo en mascotas", "gonvra": true, "competidor": false } },
        { "type": "fila", "settings": { "texto": "Envío a todo el país con seguimiento", "gonvra": true, "competidor": true } },
        { "type": "fila", "settings": { "texto": "Pago 100% seguro con Mercado Pago", "gonvra": true, "competidor": true } }
      ]
    }
  ]
}
{% endschema %}
