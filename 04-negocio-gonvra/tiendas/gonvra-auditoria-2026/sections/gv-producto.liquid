{{ 'gv-styles.css' | asset_url | stylesheet_tag }}
<script src="{{ 'gv-scripts.js' | asset_url }}" defer></script>

{%- style -%}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
  }
{%- endstyle -%}

{%- assign gv_var = product.selected_or_first_available_variant -%}
{%- assign gv_precio_json = gv_var.price | money_without_currency | remove: '.' | replace: ',', '.' -%}

{%- comment -%}
  Datos estructurados para Google: ayudan a que el producto pueda mostrar
  precio y disponibilidad directo en los resultados de búsqueda. No incluye
  aggregateRating a propósito (las reseñas de Loox todavía no son 100%
  propias del producto).
{%- endcomment -%}
<script type="application/ld+json">
{
  "@context": "https://schema.org/",
  "@type": "Product",
  "name": {{ product.title | json }},
  "image": [{% for image in product.images limit: 6 %}{{ image | image_url: width: 1200 | json }}{% unless forloop.last %},{% endunless %}{% endfor %}],
  "description": {{ product.description | strip_html | truncatewords: 60 | json }},
  {%- if gv_var.sku != blank -%}
  "sku": {{ gv_var.sku | json }},
  {%- endif -%}
  "brand": { "@type": "Brand", "name": {{ shop.name | json }} },
  "offers": {
    "@type": "Offer",
    "url": {{ request.origin | append: product.url | json }},
    "priceCurrency": {{ cart.currency.iso_code | json }},
    "price": {{ gv_precio_json | json }},
    "availability": "https://schema.org/{% if gv_var.available %}InStock{% else %}OutOfStock{% endif %}",
    "itemCondition": "https://schema.org/NewCondition"
  }
}
</script>

<section class="gv-pdp gv-section" data-gv-product data-money="{{ shop.money_format }}">
  <div class="gv-container">
    <div class="gv-pdp__inner">

      {%- comment -%} ---------- Galería ---------- {%- endcomment -%}
      <div class="gv-pdp__gallery" data-gv-gallery>
        <div class="gv-pdp__main">
          {%- if product.featured_media != blank -%}
            <img data-gv-main-img src="{{ product.featured_media | image_url: width: 1200 }}" alt="{{ product.featured_media.alt | escape }}" loading="eager" fetchpriority="high">
          {%- else -%}
            <img data-gv-main-img src="{{ 'gv-band-default.jpg' | asset_url }}" alt="{{ product.title | escape }}" loading="eager">
          {%- endif -%}
        </div>
        {%- if product.images.size > 1 -%}
          <div class="gv-pdp__thumbs">
            {%- for image in product.images limit: 8 -%}
              <button type="button" class="gv-pdp__thumb {% if forloop.first %}is-active{% endif %}" data-gv-thumb data-full="{{ image | image_url: width: 1200 }}" aria-label="Ver imagen {{ forloop.index }}">
                <img src="{{ image | image_url: width: 160 }}" alt="{{ image.alt | escape }}" loading="lazy">
              </button>
            {%- endfor -%}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%} ---------- Columna de compra ---------- {%- endcomment -%}
      <div class="gv-pdp__buy">
        <div class="gv-buybox">
          {%- if section.settings.mostrar_viral and section.settings.viral_texto != blank -%}
            <div class="gv-pdp__viral" style="background: {{ section.settings.viral_fondo | default: '#2E7FB0' }}; color: {{ section.settings.viral_color | default: '#FFFFFF' }};">{{ section.settings.viral_texto | replace: '| STOCK BAJO', '' | replace: 'STOCK BAJO', '' | replace: '|', '' | strip }}</div>
          {%- endif -%}
          {%- if section.settings.mostrar_vendor -%}
            <p class="gv-pdp__vendor">{{ product.vendor | default: shop.name }}</p>
          {%- endif -%}
          {%- for block in section.blocks -%}
            {%- if block.type == '@app' -%}
              <div class="gv-pdp__appblock" {{ block.shopify_attributes }}>{% render block %}</div>
            {%- endif -%}
          {%- endfor -%}
          <h1 class="gv-pdp__title">{{ product.title }}</h1>

          {%- if section.settings.chip1 != blank or section.settings.chip2 != blank -%}
            <div class="gv-pdp__chips">
              {%- if section.settings.chip1 != blank -%}<span class="gv-pdp__chip">{{ section.settings.chip1 }}</span>{%- endif -%}
              {%- if section.settings.chip2 != blank -%}<span class="gv-pdp__chip gv-pdp__chip--alt">{{ section.settings.chip2 }}</span>{%- endif -%}
            </div>
          {%- endif -%}

          {%- if section.settings.mostrar_rating -%}
            <div class="gv-pdp__rating">
              <span class="stars">★★★★★</span>
              <span class="count">{{ section.settings.rating_texto }}</span>
            </div>
          {%- endif -%}

          <div class="gv-pdp__price">
            <span class="now" data-gv-price-now>{{ gv_var.price | money }}</span>
            <span class="was" data-gv-price-was {% unless gv_var.compare_at_price > gv_var.price %}style="display:none"{% endunless %}>{{ gv_var.compare_at_price | money }}</span>
            <span class="off" data-gv-price-save {% unless gv_var.compare_at_price > gv_var.price %}style="display:none"{% endunless %}>
              {%- if gv_var.compare_at_price > gv_var.price -%}-{{ gv_var.compare_at_price | minus: gv_var.price | times: 100.0 | divided_by: gv_var.compare_at_price | round }}%{%- endif -%}
            </span>
          </div>

          {%- if section.settings.desc_corta != blank -%}
            <p class="gv-pdp__desc-short">{{ section.settings.desc_corta }}</p>
          {%- endif -%}

          {%- comment -%} ---------- Opciones (color en círculos / resto en pastillas) ---------- {%- endcomment -%}
          {%- unless product.has_only_default_variant -%}
            {%- for option in product.options_with_values -%}
              {%- assign opt_index = forloop.index0 -%}
              {%- assign oname = option.name | downcase -%}
              {%- assign is_color = false -%}
              {%- if oname contains 'color' or oname contains 'colour' -%}{%- assign is_color = true -%}{%- endif -%}
              <div class="gv-opt" data-gv-option-index="{{ forloop.index0 }}">
                <label class="gv-opt__label">{{ option.name }}: <b data-gv-selected-{{ forloop.index0 }}>{{ option.selected_value }}</b></label>
                <div class="gv-swatches">
                  {%- for value in option.values -%}
                    {%- if is_color -%}
                      {%- assign v = value | downcase | strip -%}
                      {%- assign hex = '' -%}
                      {%- case v -%}
                        {%- when 'negro','black' -%}{%- assign hex = '#1c1c1c' -%}
                        {%- when 'blanco','white' -%}{%- assign hex = '#f4f4f0' -%}
                        {%- when 'gris','gray','grey' -%}{%- assign hex = '#9a9a9a' -%}
                        {%- when 'plata','silver' -%}{%- assign hex = '#c8ccce' -%}
                        {%- when 'azul','blue' -%}{%- assign hex = '#2f5fce' -%}
                        {%- when 'celeste','light blue' -%}{%- assign hex = '#7fb3e6' -%}
                        {%- when 'marino','navy' -%}{%- assign hex = '#16233F' -%}
                        {%- when 'verde','green' -%}{%- assign hex = '#3ba55d' -%}
                        {%- when 'rojo','red' -%}{%- assign hex = '#d8443c' -%}
                        {%- when 'rosa','rosado','pink' -%}{%- assign hex = '#e78bb0' -%}
                        {%- when 'morado','purple','violeta','lila' -%}{%- assign hex = '#8b5cd6' -%}
                        {%- when 'amarillo','yellow' -%}{%- assign hex = '#f2c744' -%}
                        {%- when 'dorado','gold','oro' -%}{%- assign hex = '#c9a24c' -%}
                        {%- when 'naranja','orange' -%}{%- assign hex = '#ec7f3a' -%}
                        {%- when 'marrón','marron','brown','café','cafe' -%}{%- assign hex = '#8a5a3b' -%}
                        {%- when 'beige','crema','cream' -%}{%- assign hex = '#e4d8c4' -%}
                        {%- when 'turquesa','teal' -%}{%- assign hex = '#2bb0a6' -%}
                      {%- endcase -%}
                      {%- if hex != '' -%}
                        <button type="button" class="gv-swatch-color {% if value == option.selected_value %}is-active{% endif %}" data-value="{{ value | escape }}" style="background:{{ hex }};" aria-label="{{ value | escape }}" title="{{ value | escape }}"></button>
                      {%- else -%}
                        {%- assign vimg = '' -%}
                        {%- for variant in product.variants -%}
                          {%- assign optval = variant.options[opt_index] -%}
                          {%- if optval == value and variant.image != blank and vimg == '' -%}{%- assign vimg = variant.image -%}{%- endif -%}
                        {%- endfor -%}
                        {%- if vimg != '' -%}
                          <button type="button" class="gv-swatch-color gv-swatch-img {% if value == option.selected_value %}is-active{% endif %}" data-value="{{ value | escape }}" style="background-image:url('{{ vimg | image_url: width: 120 }}');" aria-label="{{ value | escape }}" title="{{ value | escape }}"></button>
                        {%- else -%}
                          <button type="button" class="gv-swatch-color {% if value == option.selected_value %}is-active{% endif %}" data-value="{{ value | escape }}" style="background:#cfd3d8;" aria-label="{{ value | escape }}" title="{{ value | escape }}"></button>
                        {%- endif -%}
                      {%- endif -%}
                    {%- else -%}
                      <button type="button" class="gv-pdp__swatch {% if value == option.selected_value %}is-active{% endif %}" data-value="{{ value | escape }}">{{ value }}</button>
                    {%- endif -%}
                  {%- endfor -%}
                </div>
              </div>
            {%- endfor -%}
          {%- endunless -%}

          <script type="application/json" data-gv-variants-json>
            [
              {%- for variant in product.variants -%}
                {"id": {{ variant.id }}, "options": {{ variant.options | json }}, "price": {{ variant.price }}, "compare_at_price": {{ variant.compare_at_price | default: 0 }}, "available": {{ variant.available }} }{%- unless forloop.last -%},{%- endunless -%}
              {%- endfor -%}
            ]
          </script>

          {%- comment -%} ---------- Elegí tu oferta ---------- {%- endcomment -%}
          {%- if section.settings.mostrar_ofertas -%}
            <div class="gv-offers" data-gv-offers>
              <div class="gv-offers__head">{{ section.settings.ofertas_titulo }}</div>

              <label class="gv-offer is-active" data-gv-offer data-qty="1" data-off="0">
                <input type="radio" name="gv-offer" checked style="display:none">
                <span class="gv-offer__radio"></span>
                <span class="gv-offer__body">
                  <span class="gv-offer__qty">{{ section.settings.oferta1_label }}</span>
                  <span class="gv-offer__sub" data-gv-offer-sub>{{ section.settings.oferta1_sub }}</span>
                </span>
                <span class="gv-offer__prices">
                  <span class="gv-offer__now" data-gv-offer-now></span>
                  <span class="gv-offer__was" data-gv-offer-was style="display:none"></span>
                </span>
              </label>

              <label class="gv-offer" data-gv-offer data-qty="2" data-off="{{ section.settings.oferta2_off }}">
                <input type="radio" name="gv-offer" style="display:none">
                <span class="gv-offer__radio"></span>
                <span class="gv-offer__body">
                  <span class="gv-offer__qty">{{ section.settings.oferta2_label }}{% if section.settings.oferta2_off > 0 %}<span class="gv-offer__off">-{{ section.settings.oferta2_off }}%</span>{% endif %}</span>
                  <span class="gv-offer__sub" data-gv-offer-sub></span>
                </span>
                <span class="gv-offer__prices">
                  <span class="gv-offer__now" data-gv-offer-now></span>
                  <span class="gv-offer__was" data-gv-offer-was></span>
                  <span class="gv-offer__unit" data-gv-offer-unit></span>
                </span>
                {%- if section.settings.oferta2_tag != blank -%}<span class="gv-offer__tag">{{ section.settings.oferta2_tag }}</span>{%- endif -%}
              </label>

              {%- if section.settings.mostrar_oferta3 -%}
                <label class="gv-offer" data-gv-offer data-qty="3" data-off="{{ section.settings.oferta3_off }}">
                  <input type="radio" name="gv-offer" style="display:none">
                  <span class="gv-offer__radio"></span>
                  <span class="gv-offer__body">
                    <span class="gv-offer__qty">{{ section.settings.oferta3_label }}{% if section.settings.oferta3_off > 0 %}<span class="gv-offer__off">-{{ section.settings.oferta3_off }}%</span>{% endif %}</span>
                    <span class="gv-offer__sub" data-gv-offer-sub></span>
                  </span>
                  <span class="gv-offer__prices">
                    <span class="gv-offer__now" data-gv-offer-now></span>
                    <span class="gv-offer__was" data-gv-offer-was></span>
                    <span class="gv-offer__unit" data-gv-offer-unit></span>
                  </span>
                  {%- if section.settings.oferta3_tag != blank -%}<span class="gv-offer__tag">{{ section.settings.oferta3_tag }}</span>{%- endif -%}
                </label>
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- comment -%} ---------- Formulario ---------- {%- endcomment -%}
          {%- form 'product', product, class: 'gv-pdp__form' -%}
            <input type="hidden" name="id" value="{{ gv_var.id }}" data-gv-variant-id>
            {%- if section.settings.mostrar_ofertas -%}
              <input type="hidden" name="quantity" value="1" data-gv-quantity>
            {%- else -%}
              <div class="gv-pdp__qty-row" style="margin-bottom:14px;">
                <div class="gv-pdp__qty" data-gv-qty>
                  <button type="button" data-step="down" aria-label="Quitar uno">−</button>
                  <input type="number" name="quantity" value="1" min="1" inputmode="numeric" data-gv-qty-input>
                  <button type="button" data-step="up" aria-label="Sumar uno">+</button>
                </div>
              </div>
            {%- endif -%}
            <button type="submit" name="add" class="gv-pdp__cta" data-gv-add
              data-label="{{ section.settings.boton_texto | escape }}"
              data-sold="{{ section.settings.boton_agotado | escape }}"
              {% unless gv_var.available %}disabled{% endunless %}>
              {%- if gv_var.available -%}{{ section.settings.boton_texto }}{%- else -%}{{ section.settings.boton_agotado }}{%- endif -%}
            </button>
          {%- endform -%}

          {%- comment -%} Aviso de escasez desactivado a propósito: el stock real es alto, no mostramos "pocas unidades" para no mentir. La urgencia real la da el contador de la promo. {%- endcomment -%}
          {%- if section.settings.mostrar_stock and section.settings.stock_texto != blank and section.settings.stock_texto != '¡Pocas unidades disponibles!' -%}
            <div class="gv-scarcity"><span class="dot"></span>{{ section.settings.stock_texto }}</div>
          {%- endif -%}

          {%- if section.settings.mostrar_pagos -%}
            <div class="gv-pay">
              <span class="gv-pay__txt">{{ section.settings.pagos_texto | replace: ', todas las tarjetas y PayPal', ' y todas las tarjetas' | replace: ' y PayPal', '' | replace: ', PayPal', '' | replace: 'PayPal', '' | replace: 'Paypal', '' | strip }}</span>
              <span class="gv-pay__icons">
                {% render 'gv-pagos' %}
              </span>
            </div>
          {%- endif -%}

          {%- comment -%} ---------- Sellos de confianza ---------- {%- endcomment -%}
          <div class="gv-badges" data-gv-carousel data-auto="3200">
            {%- if section.settings.badge1_titulo != blank -%}
              <div class="gv-badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18h5a1 1 0 0 0 1-1v-3.34a2 2 0 0 0-.6-1.43l-3.06-3a2 2 0 0 0-1.4-.57H14"/><circle cx="7.5" cy="18.5" r="1.5"/><circle cx="17.5" cy="18.5" r="1.5"/></svg>
                <span class="gv-badge__t">{{ section.settings.badge1_titulo }}</span>
                <span class="gv-badge__s">{{ section.settings.badge1_sub }}</span>
              </div>
            {%- endif -%}
            {%- if section.settings.badge2_titulo != blank -%}
              <div class="gv-badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg>
                <span class="gv-badge__t">{{ section.settings.badge2_titulo | replace: '7 días','10 días' }}</span>
                <span class="gv-badge__s">{{ section.settings.badge2_sub }}</span>
              </div>
            {%- endif -%}
            {%- if section.settings.badge3_titulo != blank -%}
              <div class="gv-badge">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="11" width="18" height="11" rx="2"/><path d="M7 11V7a5 5 0 0 1 10 0v4"/></svg>
                <span class="gv-badge__t">{{ section.settings.badge3_titulo }}</span>
                <span class="gv-badge__s">{{ section.settings.badge3_sub }}</span>
              </div>
            {%- endif -%}
          </div>

          {%- if section.settings.seal_titulo != blank -%}
            <div class="gv-seal">
              <div class="gv-seal__ring">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg>
              </div>
              <div>
                <p class="gv-seal__t">{{ section.settings.seal_titulo | replace: '7 días','10 días' }}</p>
                <p class="gv-seal__s">{{ section.settings.seal_texto | replace: '7 días','10 días' }}</p>
              </div>
            </div>
          {%- endif -%}

          {%- liquid
            assign gv_acc_count = 0
            for b in section.blocks
              if b.type == 'apartado'
                assign gv_acc_count = gv_acc_count | plus: 1
              endif
            endfor
          -%}
          {%- if gv_acc_count > 0 -%}
            <div class="gv-acc__list gv-buybox__acc" data-gv-acc>
              {%- for block in section.blocks -%}
                {%- if block.type != 'apartado' -%}{%- continue -%}{%- endif -%}
                <div class="gv-acc__item {% if block.settings.abierto %}is-open{% endif %}" {{ block.shopify_attributes }}>
                  <button type="button" class="gv-acc__head" data-gv-acc-head aria-expanded="{% if block.settings.abierto %}true{% else %}false{% endif %}">
                    <span class="gv-acc__ico">
                      {%- case block.settings.icono -%}
                        {%- when 'descripcion' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8Z"/><path d="M14 2v6h6"/><path d="M8 13h8"/><path d="M8 17h5"/></svg>
                        {%- when 'beneficios' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 15.09 8.26 22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2Z"/></svg>
                        {%- when 'caracteristicas' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="3"/><path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 1 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 1 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 1 1-2.83-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 1 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 1 1 2.83-2.83l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 1 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 1 1 2.83 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 1 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1Z"/></svg>
                        {%- when 'envios' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M14 18V6a2 2 0 0 0-2-2H4a2 2 0 0 0-2 2v11a1 1 0 0 0 1 1h2"/><path d="M15 18h5a1 1 0 0 0 1-1v-3.34a2 2 0 0 0-.6-1.43l-3.06-3a2 2 0 0 0-1.4-.57H14"/><circle cx="7.5" cy="18.5" r="1.5"/><circle cx="17.5" cy="18.5" r="1.5"/></svg>
                        {%- when 'faq' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2Z"/><path d="M9.1 9a3 3 0 0 1 5.8 1c0 2-3 2.5-3 2.5"/><path d="M12 16h.01"/></svg>
                        {%- when 'escudo' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg>
                        {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="M12 8v8"/><path d="M8 12h8"/></svg>
                      {%- endcase -%}
                    </span>
                    <span class="gv-acc__title">{{ block.settings.titulo }}</span>
                    <svg class="gv-acc__arrow" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m6 9 6 6 6-6"/></svg>
                  </button>
                  <div class="gv-acc__panel" data-gv-acc-panel>
                    <div class="gv-acc__inner">
                      {%- if block.settings.usar_descripcion -%}
                        {{ product.description }}
                      {%- else -%}
                        {{ block.settings.contenido | replace: '7 días','10 días' | replace: '30 días','10 días' }}
                      {%- endif -%}
                    </div>
                  </div>
                </div>
              {%- endfor -%}
            </div>
          {%- endif -%}
        </div>
      </div>
    </div>

    {%- comment -%} ---------- Detalle rico ---------- {%- endcomment -%}
    <div class="gv-pdp__details">
      {%- liquid
        assign gv_feat_count = 0
        for b in section.blocks
          if b.type == 'caracteristica'
            assign gv_feat_count = gv_feat_count | plus: 1
          endif
        endfor
      -%}
      {%- if gv_feat_count > 0 -%}
        <div class="gv-pdp__features" data-gv-carousel data-auto="4000">
          {%- assign gv_feat_i = 0 -%}
          {%- for block in section.blocks -%}
            {%- if block.type != 'caracteristica' -%}{%- continue -%}{%- endif -%}
            <div class="gv-pdp__feature gv-reveal" data-delay="{{ gv_feat_i | modulo: 3 | plus: 1 }}" {{ block.shopify_attributes }}>
              <div class="gv-pdp__feature__icon">
                {%- case block.settings.icono -%}
                  {%- when 'corazon' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M19 14c1.49-1.46 3-3.21 3-5.5A5.5 5.5 0 0 0 16.5 3c-1.76 0-3 .5-4.5 2-1.5-1.5-2.74-2-4.5-2A5.5 5.5 0 0 0 2 8.5c0 2.3 1.5 4.05 3 5.5l7 7Z"/></svg>
                  {%- when 'escudo' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10Z"/><path d="m9 12 2 2 4-4"/></svg>
                  {%- when 'estrella' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2 15.09 8.26 22 9.27l-5 4.87 1.18 6.88L12 17.77l-6.18 3.25L7 14.14 2 9.27l6.91-1.01L12 2Z"/></svg>
                  {%- when 'hoja' -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M11 20A7 7 0 0 1 9.8 6.1C15.5 5 17 4.48 19 2c1 2 2 4.18 2 8 0 5.5-4.78 10-10 10Z"/><path d="M2 21c0-3 1.85-5.36 5.08-6"/></svg>
                  {%- else -%}<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="9"/><path d="m9 12 2 2 4-4"/></svg>
                {%- endcase -%}
              </div>
              <h4>{{ block.settings.titulo }}</h4>
              <p>{{ block.settings.texto }}</p>
            </div>
            {%- assign gv_feat_i = gv_feat_i | plus: 1 -%}
          {%- endfor -%}
        </div>
      {%- endif -%}

      {%- if section.settings.mostrar_desc_larga and product.description != blank -%}
        <div class="gv-pdp__longdesc gv-reveal">
          <h3>{{ section.settings.desc_titulo }}</h3>
          <div class="rte">{{ product.description }}</div>
        </div>
      {%- endif -%}
    </div>
  </div>

  {%- comment -%} ---------- Barra de compra fija ---------- {%- endcomment -%}
  {%- if section.settings.mostrar_sticky -%}
    <div class="gv-stickybar" data-gv-sticky>
      <div class="gv-stickybar__inner">
        <div class="gv-stickybar__thumb">
          {%- if product.featured_image != blank -%}
            <img src="{{ product.featured_image | image_url: width: 120 }}" alt="{{ product.title | escape }}" loading="lazy">
          {%- endif -%}
        </div>
        <div class="gv-stickybar__info">
          <p class="gv-stickybar__name">{{ product.title }}</p>
          <div class="gv-stickybar__meta">
            <span class="gv-stickybar__price" data-gv-sticky-price>{{ gv_var.price | money }}</span>
            <span class="gv-stickybar__was" data-gv-sticky-was {% unless gv_var.compare_at_price > gv_var.price %}style="display:none"{% endunless %}>{{ gv_var.compare_at_price | money }}</span>
          </div>
        </div>
        <button type="button" class="gv-stickybar__btn" data-gv-sticky-btn>{{ section.settings.boton_texto }}</button>
      </div>
    </div>
  {%- endif -%}
</section>

{% schema %}
{
  "name": "GV – Página de producto",
  "tag": "section",
  "settings": [
    { "type": "checkbox", "id": "mostrar_vendor", "label": "Mostrar marca sobre el título", "default": true },
    { "type": "header", "content": "Cinta destacada" },
    { "type": "checkbox", "id": "mostrar_viral", "label": "Mostrar cinta destacada", "default": true },
    { "type": "text", "id": "viral_texto", "label": "Texto de la cinta", "default": "PRODUCTO VIRAL" },
    { "type": "color", "id": "viral_fondo", "label": "Fondo de la cinta", "default": "#2E7FB0" },
    { "type": "color", "id": "viral_color", "label": "Texto de la cinta (color)", "default": "#FFFFFF" },
    { "type": "header", "content": "Etiquetas bajo el nombre" },
    { "type": "text", "id": "chip1", "label": "Etiqueta 1 (vacío = no se muestra)" },
    { "type": "text", "id": "chip2", "label": "Etiqueta 2 (vacío = no se muestra)" },
    { "type": "checkbox", "id": "mostrar_rating", "label": "Mostrar estrellas", "default": true },
    { "type": "text", "id": "rating_texto", "label": "Texto junto a las estrellas", "default": "Valorado por nuestros clientes" },
    { "type": "textarea", "id": "desc_corta", "label": "Resumen corto (vacío = usa el del producto)" },
    { "type": "header", "content": "Elegí tu oferta (descuento por cantidad)" },
    { "type": "checkbox", "id": "mostrar_ofertas", "label": "Mostrar selector de oferta por cantidad", "default": true },
    { "type": "text", "id": "ofertas_titulo", "label": "Título del bloque", "default": "Elegí tu oferta" },
    { "type": "text", "id": "oferta1_label", "label": "Opción 1 – texto", "default": "Llevá 1 unidad" },
    { "type": "text", "id": "oferta1_sub", "label": "Opción 1 – subtítulo", "default": "Precio regular" },
    { "type": "text", "id": "oferta2_label", "label": "Opción 2 – texto", "default": "Llevá 2 unidades" },
    { "type": "range", "id": "oferta2_off", "label": "Opción 2 – descuento sobre la 2ª unidad (%)", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 30 },
    { "type": "text", "id": "oferta2_tag", "label": "Opción 2 – etiqueta", "default": "MÁS ELEGIDO" },
    { "type": "checkbox", "id": "mostrar_oferta3", "label": "Mostrar una tercera opción", "default": false },
    { "type": "text", "id": "oferta3_label", "label": "Opción 3 – texto", "default": "Llevá 3 unidades" },
    { "type": "range", "id": "oferta3_off", "label": "Opción 3 – descuento (%)", "min": 0, "max": 60, "step": 5, "unit": "%", "default": 30 },
    { "type": "text", "id": "oferta3_tag", "label": "Opción 3 – etiqueta", "default": "MEJOR PRECIO" },
    { "type": "header", "content": "Botón de compra" },
    { "type": "text", "id": "boton_texto", "label": "Texto del botón", "default": "Conseguilo ahora" },
    { "type": "text", "id": "boton_agotado", "label": "Texto cuando está agotado", "default": "Agotado" },
    { "type": "checkbox", "id": "mostrar_sticky", "label": "Mostrar barra de compra fija abajo", "default": true },
    { "type": "header", "content": "Aviso de stock" },
    { "type": "checkbox", "id": "mostrar_stock", "label": "Mostrar aviso de stock (solo si escribís un texto verdadero abajo)", "default": false },
    { "type": "text", "id": "stock_texto", "label": "Texto del aviso (evitá mentir con la escasez)" },
    { "type": "header", "content": "Medios de pago" },
    { "type": "checkbox", "id": "mostrar_pagos", "label": "Mostrar iconos de pago", "default": true },
    { "type": "text", "id": "pagos_texto", "label": "Texto sobre los iconos", "default": "Pago seguro con todos los medios" },
    { "type": "header", "content": "Sellos de confianza (3)" },
    { "type": "text", "id": "badge1_titulo", "label": "Sello 1 – título", "default": "Envío a todo el país" },
    { "type": "text", "id": "badge1_sub", "label": "Sello 1 – subtítulo", "default": "Seguimiento incluido" },
    { "type": "text", "id": "badge2_titulo", "label": "Sello 2 – título", "default": "Garantía 10 días" },
    { "type": "text", "id": "badge2_sub", "label": "Sello 2 – subtítulo", "default": "Compra protegida" },
    { "type": "text", "id": "badge3_titulo", "label": "Sello 3 – título", "default": "Pago seguro" },
    { "type": "text", "id": "badge3_sub", "label": "Sello 3 – subtítulo", "default": "Datos protegidos" },
    { "type": "header", "content": "Sello de garantía destacado" },
    { "type": "text", "id": "seal_titulo", "label": "Título", "default": "Garantía de 10 días" },
    { "type": "textarea", "id": "seal_texto", "label": "Texto", "default": "Si no quedás conforme, escribinos dentro de los 10 días y lo resolvemos. Comprá con total tranquilidad." },
    { "type": "header", "content": "Descripción larga" },
    { "type": "checkbox", "id": "mostrar_desc_larga", "label": "Mostrar la descripción larga aquí (apagala si usás el acordeón)", "default": true },
    { "type": "text", "id": "desc_titulo", "label": "Título de la descripción", "default": "Sobre este producto" },
    { "type": "header", "content": "Espaciado" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 48 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 80 }
  ],
  "blocks": [
    { "type": "@app" },
    {
      "type": "apartado",
      "name": "Apartado desplegable",
      "settings": [
        { "type": "select", "id": "icono", "label": "Icono", "default": "descripcion",
          "options": [
            {"value": "descripcion", "label": "Descripción"},
            {"value": "beneficios", "label": "Beneficios (estrella)"},
            {"value": "caracteristicas", "label": "Características (engranaje)"},
            {"value": "envios", "label": "Envíos (camión)"},
            {"value": "faq", "label": "Preguntas frecuentes"},
            {"value": "escudo", "label": "Garantía (escudo)"}
          ] },
        { "type": "text", "id": "titulo", "label": "Título", "default": "Apartado" },
        { "type": "checkbox", "id": "usar_descripcion", "label": "Usar la descripción del producto", "default": false },
        { "type": "richtext", "id": "contenido", "label": "Contenido", "default": "<p>Escribí aquí el contenido de este apartado.</p>" },
        { "type": "checkbox", "id": "abierto", "label": "Abierto al entrar", "default": false }
      ]
    },
    {
      "type": "caracteristica",
      "name": "Característica",
      "settings": [
        { "type": "select", "id": "icono", "label": "Icono", "default": "corazon",
          "options": [
            {"value": "corazon", "label": "Corazón"},
            {"value": "escudo", "label": "Escudo"},
            {"value": "estrella", "label": "Estrella"},
            {"value": "hoja", "label": "Hoja / natural"}
          ] },
        { "type": "text", "id": "titulo", "label": "Título", "default": "Característica" },
        { "type": "textarea", "id": "texto", "label": "Texto", "default": "Explica aquí un punto fuerte del producto." }
      ]
    }
  ],
  "presets": [
    {
      "name": "GV – Página de producto",
      "blocks": [
        { "type": "caracteristica", "settings": { "icono": "corazon", "titulo": "Pensado para su comodidad", "texto": "Materiales suaves y seguros para el día a día de tu mascota." } },
        { "type": "caracteristica", "settings": { "icono": "escudo", "titulo": "Calidad revisada", "texto": "Revisamos cada pedido antes de enviarlo a tu casa." } },
        { "type": "caracteristica", "settings": { "icono": "estrella", "titulo": "De los más pedidos", "texto": "Uno de los productos que más eligen en la tienda." } }
      ]
    }
  ]
}
{% endschema %}
