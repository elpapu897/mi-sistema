{% liquid
  assign current_variant = product.selected_or_first_available_variant
%}
<section class="tp-page" data-tp-page>
  <div class="tp-wrap">
    <div class="tp-top" data-tp-reveal><div class="tp-gallery">{% for media in product.media limit: 3 %}{% if media.media_type == 'image' %}<figure>{{ media.preview_image | image_url: width: 1200 | image_tag: widths: '480, 720, 960, 1200', sizes: '(min-width: 900px) 52vw, 100vw', loading: 'lazy', alt: product.title }}</figure>{% endif %}{% endfor %}</div>
      <aside class="tp-buy" id="comprar"><p class="tp-kicker">Rostro + cuerpo</p><h1>{{ product.title | escape }}</h1><p class="tp-price">{{ current_variant.price | money }}</p><p class="tp-copy">Una rasuradora compacta para mantener tu rutina de recorte clara y simple.</p><div class="tp-options" role="group" aria-label="Elegí unidades"><button class="is-selected" type="button" data-tp-unit="1" aria-pressed="true"><span><strong>Individual</strong><small>1 unidad</small></span><b>Elegir</b></button><button type="button" data-tp-unit="2" aria-pressed="false"><span><strong>Dúo</strong><small>2 unidades</small></span><b>Elegir</b></button></div><ul class="tp-list"><li>Peines guía 1, 3 y 5 mm</li><li>Recargable por USB</li><li>Color negro y verde lima</li></ul>{% form 'product', product, class:'tp-form' %}<input type="hidden" name="id" value="{{ current_variant.id }}"><input type="hidden" name="quantity" value="1" data-tp-quantity>{% if current_variant.available %}<p class="tp-stock"><i></i> Disponible para comprar</p><button type="submit">Agregar al carrito</button>{% else %}<p class="tp-stock">Sin stock</p><button type="submit" disabled>Sin stock</button>{% endif %}{% endform %}{% if shop.enabled_payment_types != blank %}<div class="tp-payments" aria-label="Métodos de pago disponibles">{% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag: class:'tp-pay-icon' }}{% endfor %}</div>{% endif %}<div class="tp-order"><div><em>1</em><span><strong>Compra</strong><small>Confirmás tu pedido.</small></span></div><div><em>2</em><span><strong>Gestión</strong><small>Se prepara para envío.</small></span></div><div><em>3</em><span><strong>Seguimiento</strong><small>Consultás su estado.</small></span></div></div></aside></div>
    <section class="tp-editorial" data-tp-reveal><p class="tp-kicker">Elegí el largo</p><h2>Un recorte que se adapta a vos.</h2><p>Usala sin peine para un acabado cercano o elegí una guía para sostener el largo. Es una herramienta de recorte: el resultado es temporal y varía con el tipo de vello.</p></section>
    <section class="tp-compare" data-tp-reveal><div><p class="tp-kicker">Comparación visual</p><h2>Mové la línea para mirar el largo.</h2><p>Demostración ilustrativa; no es una promesa de resultado idéntico.</p></div><div class="tp-slider" data-tp-slider style="--tp-position:50%"><img src="https://cdn.shopify.com/s/files/1/0722/4652/6067/files/rasuradora-integral-antes-v1.png?v=1788667109" alt="Demostración ilustrativa antes del recorte" loading="lazy" width="{{ images['rasuradora-integral-antes-v1.png'].width | default: 1100 }}" height="{{ images['rasuradora-integral-antes-v1.png'].height | default: 1375 }}"><div><img src="https://cdn.shopify.com/s/files/1/0722/4652/6067/files/rasuradora-integral-despues-v1.png?v=1788667116" alt="Demostración ilustrativa después del recorte" loading="lazy" width="{{ images['rasuradora-integral-despues-v1.png'].width | default: 1100 }}" height="{{ images['rasuradora-integral-despues-v1.png'].height | default: 1375 }}"></div><b class="tp-before">Antes</b><b class="tp-after">Después</b><span>↔</span><input type="range" min="0" max="100" value="50" aria-label="Mover comparación antes y después"></div></section>
    <section class="tp-use" data-tp-reveal><article><span>Para retocar</span><h3>Rostro</h3><p>Barba y patillas para mantener un look prolijo.</p></article><article><span>Para ajustar</span><h3>Cuerpo</h3><p>Elegí el peine guía y avanzá con movimientos suaves.</p></article><article><span>Para llevar</span><h3>Rutina</h3><p>Formato compacto y carga USB para tenerla a mano.</p></article></section>
    <section class="tp-faq" data-tp-reveal><p class="tp-kicker">Preguntas frecuentes</p><h2>Todo lo que necesitás saber.</h2><details open><summary>¿Qué incluye?</summary><p>Rasuradora, peines guía, cable USB y cepillo de limpieza.</p></details><details><summary>¿Se usa bajo el agua?</summary><p>La ficha disponible no certifica uso bajo el agua. Para cuidarla, usala en seco.</p></details><details><summary>¿Por qué no hay más colores?</summary><p>La variante vinculada al proveedor es negro y verde lima. No mostramos variantes que no puedan despacharse.</p></details><details><summary>¿El Dúo aplica un descuento?</summary><p>El selector Dúo agrega dos unidades al carrito. El total se confirma en el carrito antes de pagar.</p></details></section>
  </div>
</section>
{% stylesheet %}
  .tp-page{--ink:#16231d;--paper:#fafaf6;--muted:#66716b;--line:#dfe3dc;--lime:#c8e54a;background:var(--paper);color:var(--ink);font-family:inherit}.tp-wrap{width:min(1220px,calc(100% - 38px));margin:auto;padding:74px 0 110px}.tp-top{display:grid;grid-template-columns:1.18fr .82fr;gap:clamp(32px,7vw,94px);align-items:start}.tp-gallery{display:grid;grid-template-columns:1fr 1fr;gap:12px}.tp-gallery figure{min-height:260px;margin:0;overflow:hidden;background:#edf0e8}.tp-gallery figure:first-child{grid-column:span 2;min-height:540px}.tp-gallery img{display:block;width:100%;height:100%;object-fit:cover}.tp-buy{position:sticky;top:86px}.tp-kicker{margin:0 0 10px;color:#718d20;font-size:.72rem;font-weight:850;letter-spacing:.14em;text-transform:uppercase}.tp-buy h1,.tp-editorial h2,.tp-compare h2,.tp-faq h2{margin:0;line-height:1;letter-spacing:-.06em}.tp-buy h1{font-size:clamp(2.1rem,4vw,4rem)}.tp-price{margin:14px 0;font-size:1.3rem;font-weight:850}.tp-copy{color:var(--muted);line-height:1.55}.tp-options{display:grid;gap:9px;margin:23px 0}.tp-options button{display:flex;align-items:center;justify-content:space-between;border:1px solid var(--line);padding:15px;background:#fff;color:var(--ink);text-align:left;cursor:pointer}.tp-options button.is-selected{border-color:var(--ink);background:#f1f4e7}.tp-options span{display:grid;gap:3px}.tp-options small{color:var(--muted)}.tp-options b{color:#6f8d19;font-size:.77rem}.tp-list{display:grid;gap:8px;padding:0;margin:0 0 21px;list-style:none;font-size:.9rem}.tp-list li::before{content:'✓';margin-right:9px;color:#70911b;font-weight:900}.tp-stock{display:flex;align-items:center;gap:7px;margin:0 0 10px;color:#426923;font-size:.84rem;font-weight:750}.tp-stock i{width:8px;height:8px;border-radius:50%;background:#78a83c}.tp-form button{width:100%;border:0;padding:17px;background:var(--ink);color:#fff;font:inherit;font-size:.86rem;font-weight:850;letter-spacing:.09em;text-transform:uppercase;cursor:pointer}.tp-form button:disabled{opacity:.5;cursor:not-allowed}.tp-payments{display:flex;flex-wrap:wrap;gap:8px;margin:17px 0}.tp-pay-icon{width:42px;height:27px}.tp-order{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;border-top:1px solid var(--line);padding-top:19px}.tp-order div{display:grid;gap:6px}.tp-order em{display:grid;width:22px;height:22px;place-items:center;border-radius:50%;background:var(--lime);font-size:.72rem;font-style:normal;font-weight:850}.tp-order span{display:grid;gap:3px}.tp-order strong{font-size:.76rem}.tp-order small{color:var(--muted);font-size:.68rem;line-height:1.25}.tp-editorial{display:grid;grid-template-columns:.8fr 1.2fr;gap:11vw;margin:125px 0 68px;padding-top:20px;border-top:1px solid var(--ink)}.tp-editorial h2,.tp-compare h2,.tp-faq h2{font-size:clamp(2.1rem,5vw,5rem)}.tp-editorial>p:last-child{max-width:550px;margin:35px 0 0;color:var(--muted);font-size:1.08rem;line-height:1.6}.tp-compare{display:grid;grid-template-columns:.75fr 1.25fr;gap:7vw;align-items:center;margin:0 0 110px}.tp-compare>div>p:last-child{color:var(--muted);line-height:1.5}.tp-slider{position:relative;aspect-ratio:4/5;overflow:hidden;background:#e8e8df}.tp-slider>img,.tp-slider>div{position:absolute;inset:0;width:100%;height:100%}.tp-slider>img,.tp-slider>div img{display:block;width:100%;height:100%;object-fit:cover}.tp-slider>div{width:var(--tp-position);overflow:hidden}.tp-slider>div img{max-width:none}.tp-slider b{position:absolute;top:15px;z-index:2;padding:7px 10px;background:rgba(22,35,29,.9);color:#fff;font-size:.75rem}.tp-before{right:15px}.tp-after{left:15px}.tp-slider>span{position:absolute;z-index:2;top:50%;left:var(--tp-position);display:grid;width:40px;height:40px;place-items:center;border:2px solid #fff;border-radius:50%;background:var(--ink);color:#fff;transform:translate(-50%,-50%);pointer-events:none}.tp-slider input{position:absolute;z-index:3;inset:0;width:100%;height:100%;margin:0;cursor:ew-resize;opacity:0}.tp-use{display:grid;grid-template-columns:repeat(3,1fr);border-top:1px solid var(--line);border-bottom:1px solid var(--line);margin-bottom:110px}.tp-use article{padding:29px 24px 35px}.tp-use article+article{border-left:1px solid var(--line)}.tp-use span{color:#70911b;font-size:.78rem;font-weight:800}.tp-use h3{margin:35px 0 8px;font-size:1.23rem}.tp-use p{max-width:260px;margin:0;color:var(--muted);line-height:1.5}.tp-faq{max-width:850px;margin:auto}.tp-faq details{border-top:1px solid var(--line)}.tp-faq details:last-child{border-bottom:1px solid var(--line)}.tp-faq summary{display:flex;justify-content:space-between;gap:20px;padding:20px 0;cursor:pointer;font-weight:800;list-style:none}.tp-faq summary::-webkit-details-marker{display:none}.tp-faq summary::after{content:'+';color:#71901e;font-size:1.35rem}.tp-faq details[open] summary::after{content:'−'}.tp-faq details p{max-width:700px;margin:-2px 0 20px;color:var(--muted);line-height:1.55}.tp-page [data-tp-reveal]{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease}.tp-page [data-tp-reveal].is-visible{opacity:1;transform:none}@media(max-width:800px){.tp-wrap{width:min(100% - 24px,1220px);padding:48px 0 75px}.tp-top,.tp-editorial,.tp-compare{grid-template-columns:1fr}.tp-buy{position:static;margin-top:30px}.tp-gallery figure:first-child{min-height:370px}.tp-editorial{gap:15px;margin:78px 0 48px}.tp-editorial>p:last-child{margin:0}.tp-compare{gap:28px;margin-bottom:75px}.tp-use{grid-template-columns:1fr;margin-bottom:75px}.tp-use article+article{border-top:1px solid var(--line);border-left:0}.tp-order{gap:11px}}
{% endstylesheet %}
{% javascript %}
  const productObserver = new IntersectionObserver((entries) => { entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); productObserver.unobserve(entry.target); } }); }, { threshold: .12 }); document.querySelectorAll('.tp-page [data-tp-reveal]').forEach((element) => productObserver.observe(element)); document.querySelectorAll('[data-tp-page]').forEach((page) => { const quantity = page.querySelector('[data-tp-quantity]'); page.querySelectorAll('[data-tp-unit]').forEach((button) => { button.addEventListener('click', () => { page.querySelectorAll('[data-tp-unit]').forEach((item) => { item.classList.remove('is-selected'); item.setAttribute('aria-pressed','false'); }); button.classList.add('is-selected'); button.setAttribute('aria-pressed','true'); quantity.value=button.dataset.tpUnit; }); }); page.querySelectorAll('[data-tp-slider]').forEach((slider) => { const input=slider.querySelector('input'); input.addEventListener('input',() => slider.style.setProperty('--tp-position',`${input.value}%`)); }); });
{% endjavascript %}
{% schema %}
{"name":"Producto tienda","tag":"section","class":"section-tienda-producto","settings":[]}
{% endschema %}
