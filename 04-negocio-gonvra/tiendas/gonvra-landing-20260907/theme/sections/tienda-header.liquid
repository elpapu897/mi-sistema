<header class="ts-header">
  <div class="ts-header__inner">
    <a class="ts-header__home" href="{{ routes.root_url }}">Inicio</a>
    <nav aria-label="Navegación principal"><a href="{{ routes.root_url }}">Inicio</a><a href="/products/face-body-electric-shaver">Catálogo</a></nav>
    <a class="ts-header__catalog" href="/products/face-body-electric-shaver">Ver rasuradora <span aria-hidden="true">↗</span></a>
  </div>
</header>

{% stylesheet %}
  .ts-header { position:sticky; top:0; z-index:20; border-bottom:1px solid #e2e5dd; background:rgba(250,250,246,.96); backdrop-filter:blur(12px); font-family:inherit; }.ts-header__inner { display:grid; grid-template-columns:1fr auto 1fr; width:min(1220px, calc(100% - 32px)); min-height:64px; margin:auto; align-items:center; color:#16231d; }.ts-header a { color:inherit; text-decoration:none; font-size:.84rem; font-weight:750; }.ts-header nav { display:flex; gap:28px; }.ts-header nav a:first-child { border-bottom:1px solid #16231d; padding-bottom:4px; }.ts-header__catalog { justify-self:end; }.ts-header__catalog span { color:#79971e; font-size:1rem; } @media (max-width:650px) { .ts-header__inner { grid-template-columns:1fr auto; }.ts-header nav { display:none; }.ts-header__catalog { font-size:.76rem; } }
{% endstylesheet %}

{% schema %}
{"name":"Navegación tienda","tag":"section","class":"section-tienda-header","settings":[]}
{% endschema %}
