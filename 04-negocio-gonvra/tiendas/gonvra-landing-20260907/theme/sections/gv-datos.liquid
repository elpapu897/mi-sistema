{%- if section.settings.wave -%}
  {% render 'gv-wave', from: section.settings.wave_from, fill: '#101a16', accent: '#c8e54a', uid: section.id %}
{%- endif -%}
<section class="gvd" data-gvd>
  <div class="gvd-wrap">
    {% if section.settings.heading != blank %}
      <h2 class="gvd-h" data-gvd-reveal>{{ section.settings.heading }}</h2>
    {% endif %}
    {% if section.settings.sub != blank %}
      <p class="gvd-sub" data-gvd-reveal>{{ section.settings.sub }}</p>
    {% endif %}

    <ul class="gvd-grid">
      {% for block in section.blocks %}
        <li data-gvd-reveal {{ block.shopify_attributes }}>
          <b class="gvd-num" data-gvd-num="{{ block.settings.number }}">{{ block.settings.number }}{{ block.settings.suffix }}</b>
          <strong>{{ block.settings.title }}</strong>
          {% if block.settings.text != blank %}<p>{{ block.settings.text }}</p>{% endif %}
        </li>
      {% endfor %}
    </ul>

    {% if section.settings.foot != blank %}
      <p class="gvd-foot" data-gvd-reveal>{{ section.settings.foot }}</p>
    {% endif %}
  </div>
</section>

{% stylesheet %}
.gvw{position:relative;line-height:0;margin-bottom:-1px;overflow:hidden}
.gvw-svg{display:block;width:100%;height:clamp(52px,7vw,110px)}
.gvw-p{will-change:transform}
.gvw-p1{opacity:.34;animation:gvw-slide 19s linear infinite}
.gvw-p2{opacity:.55;animation:gvw-slide 13s linear infinite reverse}
.gvw-p3{animation:gvw-slide 26s linear infinite}
@keyframes gvw-slide{from{transform:translateX(0)}to{transform:translateX(-1440px)}}
@media (prefers-reduced-motion:reduce){.gvw-p{animation:none}}


.gvd{background:#101a16;color:#f4f5ef;font-family:inherit}
.gvd-wrap{width:min(1280px,calc(100% - 36px));margin:auto;padding:clamp(56px,7vw,92px) 0}
.gvd-h{max-width:20ch;margin:0 auto;font-size:clamp(1.7rem,3.4vw,2.9rem);line-height:1.06;letter-spacing:-.035em;text-align:center}
.gvd-sub{max-width:56ch;margin:14px auto 0;color:#a8b3a6;font-size:.95rem;line-height:1.6;text-align:center}
.gvd-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(20px,3vw,44px);margin:clamp(38px,5vw,64px) 0 0;padding:0;list-style:none}
.gvd-grid li{display:grid;gap:8px;padding-top:22px;border-top:1px solid #2a3830;text-align:left}
.gvd-num{font-size:clamp(2.6rem,5.6vw,4.4rem);font-weight:800;line-height:.9;letter-spacing:-.05em;color:#c8e54a;font-variant-numeric:tabular-nums}
.gvd-grid strong{font-size:1rem;line-height:1.3}
.gvd-grid p{margin:0;color:#9daa9c;font-size:.85rem;line-height:1.55}
.gvd-foot{margin:clamp(30px,4vw,48px) 0 0;color:#7d8a7d;font-size:.72rem;line-height:1.5;text-align:center}
.gvd [data-gvd-reveal]{opacity:0;transform:translateY(22px);transition:opacity .7s ease,transform .7s ease}
.gvd [data-gvd-reveal].is-in{opacity:1;transform:none}
@media(max-width:760px){.gvd-grid{grid-template-columns:1fr;gap:26px}.gvd-h{text-align:left}.gvd-sub{text-align:left;margin-left:0}.gvd-foot{text-align:left}}

.gvd-grid>li:nth-child(2){transition-delay:.12s}
.gvd-grid>li:nth-child(3){transition-delay:.24s}
.gvd-grid>li:nth-child(4){transition-delay:.36s}
{% endstylesheet %}

{% javascript %}
(() => {
  document.querySelectorAll('[data-gvd]').forEach((root) => {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => {
        if (!e.isIntersecting) return;
        e.target.classList.add('is-in');
        const num = e.target.querySelector('[data-gvd-num]');
        if (num && !num.dataset.done) {
          const raw = num.dataset.gvdNum;
          const target = parseInt(String(raw).replace(/\D/g, ''), 10);
          if (!isNaN(target) && target > 0 && target < 100000) {
            num.dataset.done = '1';
            const suffix = num.textContent.replace(String(raw), '');
            let step = 0;
            const total = 34;
            const run = setInterval(() => {
              step++;
              const value = Math.round((target * step) / total);
              num.textContent = value + suffix;
              if (step >= total) { clearInterval(run); num.textContent = raw + suffix; }
            }, 22);
          }
        }
        io.unobserve(e.target);
      });
    }, { threshold: .25 });
    root.querySelectorAll('[data-gvd-reveal]').forEach((el) => io.observe(el));
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "GONVRA · Números",
  "tag": "section",
  "class": "section-gv-datos",
  "settings": [
    { "type": "checkbox", "id": "wave", "label": "Ola de transición arriba", "default": true },
    { "type": "color", "id": "wave_from", "label": "Color de la sección de arriba", "default": "#f7f6f1" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Una sola herramienta, toda tu rutina" },
    { "type": "text", "id": "sub", "label": "Bajada", "default": "Datos de la rasuradora, no promesas: esto es lo que viene y lo que hace." },
    { "type": "text", "id": "foot", "label": "Nota al pie", "default": "Los resultados varían según el tipo y grosor del vello. Es una rasuradora de recorte: el efecto es temporal." }
  ],
  "blocks": [
    {
      "type": "dato",
      "name": "Número",
      "settings": [
        { "type": "text", "id": "number", "label": "Número", "default": "3" },
        { "type": "text", "id": "suffix", "label": "Símbolo" },
        { "type": "text", "id": "title", "label": "Título", "default": "Largos de corte" },
        { "type": "text", "id": "text", "label": "Detalle", "default": "Peines guía de 1, 3 y 5 mm incluidos." }
      ]
    }
  ],
  "presets": [
    {
      "name": "GONVRA · Números",
      "blocks": [
        { "type": "dato", "settings": { "number": "3", "suffix": "", "title": "Largos de corte", "text": "Peines guía de 1, 3 y 5 mm incluidos en la caja." } },
        { "type": "dato", "settings": { "number": "2", "suffix": "", "title": "Zonas de uso", "text": "Rostro y cuerpo con el mismo equipo: barba, patillas, brazos y piernas." } },
        { "type": "dato", "settings": { "number": "0", "suffix": "", "title": "Cuchillas descartables", "text": "Cabezal reemplazable y carga por USB: no comprás repuestos todos los meses." } }
      ]
    }
  ]
}
{% endschema %}
