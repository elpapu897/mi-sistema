<section class="gvv" data-gvv{% if section.settings.bg != blank %} style="background:{{ section.settings.bg }}"{% endif %}>
  <div class="gvv-wrap">
    <header class="gvv-head" data-gvv-reveal>
      {% if section.settings.kicker != blank %}<p class="gvv-kicker">{{ section.settings.kicker }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.sub != blank %}<p class="gvv-sub">{{ section.settings.sub }}</p>{% endif %}
    </header>

    <div class="gvv-rail" data-gvv-rail>
      {% for block in section.blocks %}
        <article class="gvv-card" data-gvv-reveal {{ block.shopify_attributes }}>
          <button class="gvv-zoom" type="button" data-gvv-zoom aria-label="Ampliar {{ block.settings.title | escape }}"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M4 9V4h5M20 15v5h-5M15 4h5v5M9 20H4v-5"/></svg></button>
          <div class="gvv-media">
            {% if block.settings.video != blank %}
              {{ block.settings.video | video_tag: image_size: '640x', loop: true, muted: true, playsinline: true, controls: true, preload: 'metadata' }}
            {% elsif block.settings.video_url != blank %}
              <video src="{{ block.settings.video_url }}" autoplay muted loop playsinline preload="metadata"{% if block.settings.image != blank %} poster="{{ block.settings.image | image_url: width: 720 }}"{% endif %}></video>
            {% elsif block.settings.clip != blank %}
              <img src="{{ block.settings.clip | asset_url }}" width="460" height="818" loading="lazy" decoding="async" alt="{{ block.settings.title | escape }}">
            {% elsif block.settings.image != blank %}
              {{ block.settings.image | image_url: width: 800 | image_tag: widths: '320, 520, 800', sizes: '(min-width: 900px) 30vw, 78vw', loading: 'lazy', alt: block.settings.title }}
            {% elsif section.settings.use_assets and forloop.index <= 3 %}
              {% assign clip_asset = 'gv-clip-' | append: forloop.index | append: '.jpg' %}
              <img src="{{ clip_asset | asset_url }}" width="720" height="1280" loading="lazy" alt="{{ block.settings.title | escape }}">
            {% else %}
              <div class="gvv-ph"></div>
            {% endif %}
          </div>
          <div class="gvv-info">
            <strong>{{ block.settings.title }}</strong>
            {% if block.settings.text != blank %}<small>{{ block.settings.text }}</small>{% endif %}
          </div>
        </article>
      {% endfor %}
    </div>

    {% if section.settings.note != blank %}<p class="gvv-note" data-gvv-reveal>{{ section.settings.note }}</p>{% endif %}
  </div>
  <div class="gvv-lightbox" data-gvv-lightbox hidden>
    <button type="button" data-gvv-close aria-label="Cerrar">×</button>
    <div data-gvv-stage></div>
  </div>
</section>

{% stylesheet %}
.gvv{background:#101a16;color:#f4f5ef;font-family:inherit;overflow:hidden}
.gvv-wrap{width:min(1280px,calc(100% - 36px));margin:auto;padding:clamp(64px,8vw,116px) 0 clamp(78px,9vw,136px)}
.gvv-head{max-width:62ch}
.gvv-kicker{margin:0 0 11px;color:#c8e54a;font-size:.68rem;font-weight:850;letter-spacing:.16em;text-transform:uppercase}
.gvv-head h2{margin:0;font-size:clamp(1.7rem,3.6vw,3rem);line-height:1.05;letter-spacing:-.035em}
.gvv-sub{margin:14px 0 0;color:#a3ae9f;font-size:.95rem;line-height:1.6}
.gvv-rail{display:grid;grid-auto-flow:column;grid-auto-columns:minmax(0,1fr);gap:clamp(12px,1.8vw,22px);margin:clamp(30px,4vw,52px) 0 0}
.gvv-card{display:grid;gap:12px}
.gvv-media{position:relative;overflow:hidden;border-radius:16px;background:#1a2620;aspect-ratio:9/16}
.gvv-media img,.gvv-media video,.gvv-ph{display:block;width:100%;height:100%;object-fit:cover}
.gvv-media .shopify-video-wrapper,.gvv-media deferred-media{display:block;height:100%}
.gvv-ph{background:linear-gradient(150deg,#1d2b24,#243228)}
.gvv-info{display:grid;gap:3px;padding:0 3px}
.gvv-info strong{font-size:.94rem}
.gvv-info small{color:#98a496;font-size:.79rem;line-height:1.45}
.gvv-note{margin:clamp(26px,3vw,38px) 0 0;color:#7c8a7c;font-size:.72rem;line-height:1.5}
.gvv-card{position:relative}
.gvv-zoom{position:absolute;top:12px;right:12px;z-index:2;display:grid;width:34px;height:34px;place-items:center;border:0;border-radius:50%;background:rgba(16,26,22,.62);color:#fff;cursor:pointer;opacity:0;transition:opacity .2s;backdrop-filter:blur(5px)}
.gvv-zoom svg{width:16px;height:16px}
.gvv-card:hover .gvv-zoom{opacity:1}
.gvv-lightbox[hidden]{display:none!important}
.gvv-lightbox{position:fixed;inset:0;z-index:90;display:grid;place-items:center;padding:24px;background:rgba(8,13,11,.92);backdrop-filter:blur(6px)}
.gvv-lightbox img,.gvv-lightbox video{max-width:min(460px,92vw);max-height:86vh;border-radius:18px;display:block}
.gvv-lightbox button[data-gvv-close]{position:absolute;top:18px;right:20px;width:44px;height:44px;border:0;border-radius:50%;background:rgba(255,255,255,.14);color:#fff;font-size:1.7rem;line-height:1;cursor:pointer}
@media(max-width:860px){.gvv-zoom{opacity:1}}
.gvv [data-gvv-reveal]{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease}
.gvv [data-gvv-reveal].is-in{opacity:1;transform:none}
@media(max-width:860px){
.gvv-wrap{width:min(100% - 24px,1280px)}
.gvv-rail{grid-auto-columns:74%;overflow-x:auto;scroll-snap-type:x mandatory;padding-bottom:8px;scrollbar-width:none}
.gvv-rail::-webkit-scrollbar{display:none}
.gvv-card{scroll-snap-align:start}
}

.gvv-rail>*:nth-child(2){transition-delay:.12s}
.gvv-rail>*:nth-child(3){transition-delay:.24s}
.gvv-rail>*:nth-child(4){transition-delay:.36s}
{% endstylesheet %}

{% javascript %}
(() => {
  document.querySelectorAll('[data-gvv]').forEach((root) => {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
    }, { threshold: .12 });
    root.querySelectorAll('[data-gvv-reveal]').forEach((el) => io.observe(el));

    const box = root.querySelector('[data-gvv-lightbox]');
    const stage = root.querySelector('[data-gvv-stage]');
    const cerrar = () => { box.hidden = true; stage.innerHTML = ''; document.body.style.overflow = ''; };
    root.querySelectorAll('[data-gvv-zoom]').forEach((btn) => {
      btn.addEventListener('click', () => {
        const media = btn.parentElement.querySelector('img, video');
        if (!media || !box) return;
        stage.innerHTML = '';
        stage.appendChild(media.cloneNode(true));
        box.hidden = false;
        document.body.style.overflow = 'hidden';
      });
    });
    root.querySelector('[data-gvv-close]')?.addEventListener('click', cerrar);
    box?.addEventListener('click', (e) => { if (e.target === box) cerrar(); });
    document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && box && !box.hidden) cerrar(); });
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "GONVRA · Videos",
  "tag": "section",
  "class": "section-gv-videos",
  "settings": [
    { "type": "color", "id": "bg", "label": "Color de fondo", "default": "#16241d" },
    { "type": "text", "id": "kicker", "label": "Bajada corta", "default": "En movimiento" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Mirá cómo se usa" },
    { "type": "text", "id": "sub", "label": "Bajada", "default": "Videos cortos del producto real: cómo se cambia el cabezal, cómo se carga y cómo queda el recorte." },
    { "type": "text", "id": "note", "label": "Nota al pie", "default": "Fotos del producto real. Cuando tengas videos propios, subilos en cada tarjeta desde el editor del tema." },
    { "type": "checkbox", "id": "use_assets", "label": "Usar las fotos del tema si no hay video", "default": true }
  ],
  "blocks": [
    {
      "type": "clip",
      "name": "Video o foto",
      "settings": [
        { "type": "video", "id": "video", "label": "Video subido a Shopify (9:16)" },
        { "type": "text", "id": "video_url", "label": "URL de un video .mp4" },
        { "type": "text", "id": "clip", "label": "Clip del tema (ej: gv-clip-rostro.webp)" },
        { "type": "image_picker", "id": "image", "label": "Imagen (si no hay video)" },
        { "type": "text", "id": "title", "label": "Título", "default": "Cómo se usa" },
        { "type": "text", "id": "text", "label": "Detalle", "default": "Rostro y cuerpo con el mismo equipo." }
      ]
    }
  ],
  "presets": [
    {
      "name": "GONVRA · Videos",
      "blocks": [
        { "type": "clip", "settings": { "title": "Rostro y patillas", "text": "Recorte parejo con el peine de 3 mm." } },
        { "type": "clip", "settings": { "title": "Cuerpo", "text": "Brazos, piernas y pecho con la misma máquina." } },
        { "type": "clip", "settings": { "title": "Qué trae la caja", "text": "Peines, cabezales, cable USB y cepillo." } }
      ]
    }
  ]
}
{% endschema %}
