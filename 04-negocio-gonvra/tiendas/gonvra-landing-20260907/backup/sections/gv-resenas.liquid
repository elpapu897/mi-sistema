{% liquid
  assign total = 0
  assign sum = 0
  assign s5 = 0
  assign s4 = 0
  assign s3 = 0
  assign s2 = 0
  assign s1 = 0
  for block in section.blocks
    assign total = total | plus: 1
    assign stars = block.settings.stars | plus: 0
    assign sum = sum | plus: stars
    case stars
      when 5
        assign s5 = s5 | plus: 1
      when 4
        assign s4 = s4 | plus: 1
      when 3
        assign s3 = s3 | plus: 1
      when 2
        assign s2 = s2 | plus: 1
      else
        assign s1 = s1 | plus: 1
    endcase
  endfor
  if total > 0
    assign avg = sum | times: 10 | divided_by: total
    assign avg_int = avg | divided_by: 10
    assign avg_dec = avg | modulo: 10
  endif
%}

{%- if section.settings.wave -%}
  {% render 'gv-wave', from: section.settings.wave_from, fill: '#f0f1ea', accent: '#dff0a8', uid: section.id %}
{%- endif -%}
<section class="gvr" id="resenas" data-gvr>
  <div class="gvr-wrap">
    <header class="gvr-head" data-gvr-reveal>
      {% if section.settings.kicker != blank %}<p class="gvr-kicker">{{ section.settings.kicker }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
    </header>

    {% if total > 0 %}
      <div class="gvr-summary" data-gvr-reveal>
        <div class="gvr-score">
          <b>{{ avg_int }},{{ avg_dec }}</b>
          <span aria-hidden="true">★★★★★</span>
          <small>{{ total }} {% if total == 1 %}reseña{% else %}reseñas{% endif %} de compradores</small>
        </div>
        <ul class="gvr-bars">
          {% assign counts = s5 | append: ',' | append: s4 | append: ',' | append: s3 | append: ',' | append: s2 | append: ',' | append: s1 | split: ',' %}
          {% for c in counts %}
            {% assign n = c | plus: 0 %}
            {% assign pct = 0 %}
            {% if total > 0 %}{% assign pct = n | times: 100 | divided_by: total %}{% endif %}
            <li>
              <span>{{ 5 | minus: forloop.index0 }}★</span>
              <i><b style="width:{{ pct }}%"></b></i>
              <small>{{ n }}</small>
            </li>
          {% endfor %}
        </ul>
      </div>

      <div class="gvr-grid">
        {% for block in section.blocks %}
          <article class="gvr-card" data-gvr-reveal {{ block.shopify_attributes }}>
            <div class="gvr-card__top">
              <span class="gvr-stars" aria-label="{{ block.settings.stars }} de 5">
                {% for i in (1..5) %}{% if i <= block.settings.stars %}★{% else %}☆{% endif %}{% endfor %}
              </span>
              {% if block.settings.verified %}<b class="gvr-check">Compra verificada</b>{% endif %}
            </div>
            {% if block.settings.title != blank %}<h3>{{ block.settings.title }}</h3>{% endif %}
            <p>{{ block.settings.text }}</p>
            {% if block.settings.image != blank %}
              <div class="gvr-photo">{{ block.settings.image | image_url: width: 600 | image_tag: widths: '280, 480, 600', loading: 'lazy', alt: block.settings.name }}</div>
            {% endif %}
            <footer>
              <strong>{{ block.settings.name }}</strong>
              {% if block.settings.meta != blank %}<small>{{ block.settings.meta }}</small>{% endif %}
            </footer>
          </article>
        {% endfor %}
      </div>
    {% else %}
      <div class="gvr-empty" data-gvr-reveal>
        <p class="gvr-empty__title">{{ section.settings.empty_title }}</p>
        <p class="gvr-empty__text">{{ section.settings.empty_text }}</p>
        <a class="gvr-empty__cta" href="#comprar">{{ section.settings.empty_cta }}</a>
      </div>
    {% endif %}

    {% if section.settings.foot != blank %}<p class="gvr-foot">{{ section.settings.foot }}</p>{% endif %}
  </div>
</section>

{% stylesheet %}
.gvw{position:relative;line-height:0;margin-bottom:-1px;overflow:hidden}
.gvw-svg{display:block;width:100%;height:clamp(52px,7vw,110px)}
.gvw-p{will-change:transform}
.gvw-p1{opacity:.34;animation:gvw-slide 19s linear infinite}
.gvw-p2{opacity:.55;animation:gvw-slide 13s linear infinite reverse}
.gvw-p3{animation:gvw-slide 26s linear infinite}
@keyframes gvw-slide{from{transform:translateX(0)}to{transform:translateX(-1440px)}}
@media (prefers-reduced-motion:reduce){.gvw-p{animation:none}}


.gvr{background:#f0f1ea;color:#101a16;font-family:inherit}
.gvr-wrap{width:min(1180px,calc(100% - 36px));margin:auto;padding:clamp(52px,6.5vw,90px) 0}
.gvr-head{max-width:56ch}
.gvr-kicker{margin:0 0 11px;color:#6d8b1c;font-size:.68rem;font-weight:850;letter-spacing:.16em;text-transform:uppercase}
.gvr-head h2{margin:0;font-size:clamp(1.7rem,3.4vw,2.9rem);line-height:1.05;letter-spacing:-.035em}
.gvr-summary{display:grid;grid-template-columns:auto 1fr;gap:clamp(22px,4vw,56px);align-items:center;margin:clamp(26px,3.5vw,44px) 0 0;padding:22px 24px;border:1px solid #dfe2da;border-radius:16px;background:#fff}
.gvr-score{display:grid;justify-items:center;gap:3px}
.gvr-score b{font-size:2.6rem;font-weight:800;line-height:1;letter-spacing:-.04em}
.gvr-score>span{color:#6d8b1c;font-size:1rem;letter-spacing:.1em}
.gvr-score small{color:#6b7570;font-size:.76rem}
.gvr-bars{display:grid;gap:6px;margin:0;padding:0;list-style:none}
.gvr-bars li{display:grid;grid-template-columns:30px 1fr 22px;gap:10px;align-items:center;font-size:.74rem;color:#6b7570}
.gvr-bars i{display:block;height:7px;border-radius:99px;background:#e6e8e0;overflow:hidden}
.gvr-bars b{display:block;height:100%;border-radius:99px;background:#c8e54a}
.gvr-bars small{text-align:right;font-variant-numeric:tabular-nums}
.gvr-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:14px;margin:16px 0 0}
.gvr-card{display:grid;gap:9px;align-content:start;padding:20px;border:1px solid #dfe2da;border-radius:16px;background:#fff}
.gvr-card__top{display:flex;align-items:center;justify-content:space-between;gap:10px}
.gvr-stars{color:#6d8b1c;font-size:.92rem;letter-spacing:.09em}
.gvr-check{padding:3px 8px;border-radius:999px;background:#eaf4d4;color:#41520f;font-size:.62rem;font-weight:800;letter-spacing:.05em}
.gvr-card h3{margin:0;font-size:.98rem;line-height:1.25}
.gvr-card p{margin:0;color:#5d675e;font-size:.88rem;line-height:1.6}
.gvr-photo{overflow:hidden;border-radius:11px;aspect-ratio:4/3;background:#eef0e9}
.gvr-photo img{display:block;width:100%;height:100%;object-fit:cover}
.gvr-card footer{display:flex;align-items:baseline;gap:8px;margin-top:2px;padding-top:11px;border-top:1px solid #edefe8}
.gvr-card footer strong{font-size:.83rem}
.gvr-card footer small{color:#8b948a;font-size:.72rem}
.gvr-empty{margin:clamp(26px,3.5vw,44px) 0 0;padding:clamp(30px,5vw,54px);border:1.5px dashed #cdd3c6;border-radius:18px;background:#fff;text-align:center}
.gvr-empty__title{margin:0;font-size:1.15rem;font-weight:750}
.gvr-empty__text{max-width:52ch;margin:10px auto 0;color:#6b7570;font-size:.9rem;line-height:1.6}
.gvr-empty__cta{display:inline-block;margin:20px 0 0;padding:15px 28px;border-radius:11px;background:#101a16;color:#fff;font-size:.78rem;font-weight:850;letter-spacing:.13em;text-transform:uppercase;text-decoration:none}
.gvr-foot{margin:22px 0 0;color:#8a938a;font-size:.72rem;line-height:1.5}
.gvr [data-gvr-reveal]{opacity:0;transform:translateY(22px);transition:opacity .7s ease,transform .7s ease}
.gvr [data-gvr-reveal].is-in{opacity:1;transform:none}
@media(max-width:900px){.gvr-grid{grid-template-columns:1fr 1fr}}
@media(max-width:620px){
.gvr-wrap{width:min(100% - 24px,1180px)}
.gvr-summary{grid-template-columns:1fr;gap:18px;padding:18px}
.gvr-grid{grid-template-columns:1fr}
}
{% endstylesheet %}

{% javascript %}
(() => {
  document.querySelectorAll('[data-gvr]').forEach((root) => {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
    }, { threshold: .1 });
    root.querySelectorAll('[data-gvr-reveal]').forEach((el) => io.observe(el));
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "GONVRA · Reseñas",
  "tag": "section",
  "class": "section-gv-resenas",
  "settings": [
    { "type": "checkbox", "id": "wave", "label": "Ola de transición arriba", "default": true },
    { "type": "color", "id": "wave_from", "label": "Color de la sección de arriba", "default": "#f7f6f1" },
    { "type": "text", "id": "kicker", "label": "Bajada corta", "default": "Opiniones" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Qué dicen quienes la compraron" },
    { "type": "paragraph", "content": "El promedio y las estrellas se calculan solos con las reseñas que cargues acá. Si no cargás ninguna, se muestra el estado 'todavía no hay reseñas'." },
    { "type": "text", "id": "empty_title", "label": "Vacío · título", "default": "Todavía no hay reseñas de este producto" },
    { "type": "text", "id": "empty_text", "label": "Vacío · texto", "default": "Somos una tienda nueva y preferimos no inventar opiniones. Si comprás, te vamos a pedir la tuya: es la que va a ayudar al que venga después." },
    { "type": "text", "id": "empty_cta", "label": "Vacío · botón", "default": "Ver el producto" },
    { "type": "text", "id": "foot", "label": "Nota al pie", "default": "Publicamos las reseñas tal como las recibimos de clientes que compraron en esta tienda." }
  ],
  "blocks": [
    {
      "type": "resena",
      "name": "Reseña real",
      "settings": [
        { "type": "range", "id": "stars", "label": "Estrellas", "min": 1, "max": 5, "step": 1, "default": 5 },
        { "type": "text", "id": "title", "label": "Título" },
        { "type": "textarea", "id": "text", "label": "Reseña" },
        { "type": "text", "id": "name", "label": "Nombre" },
        { "type": "text", "id": "meta", "label": "Detalle (ciudad, fecha)" },
        { "type": "image_picker", "id": "image", "label": "Foto del cliente" },
        { "type": "checkbox", "id": "verified", "label": "Compra verificada", "default": true }
      ]
    }
  ],
  "presets": [{ "name": "GONVRA · Reseñas" }]
}
{% endschema %}
