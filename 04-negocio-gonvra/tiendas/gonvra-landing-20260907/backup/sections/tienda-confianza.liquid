{% liquid
  assign has_payments = false
  assign mercado_pago_enabled = false
  for type in shop.enabled_payment_types
    assign has_payments = true
    if type contains 'mercado'
      assign mercado_pago_enabled = true
    endif
  endfor
%}

<section class="tc-section">
  <div class="tc-wrap">
    <div class="tc-heading" data-tc-reveal><p>COMPRA CON CONFIANZA</p><h2>Todo claro antes de confirmar.</h2><span>La página te muestra unidades, precio y medios habilitados para que elijas con tranquilidad.</span></div>
    <div class="tc-grid" data-tc-reveal>
      <article class="tc-payment-card">
        <div class="tc-card-top"><span class="tc-icon">$</span><div><p>MEDIOS DE PAGO</p><h3>Pagá como te resulte más cómodo.</h3></div></div>
        {% if has_payments %}
          <div class="tc-payment-icons" aria-label="Medios de pago habilitados en la tienda">
            {% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag: class: 'tc-payment-icon' }}{% endfor %}
          </div>
          {% if mercado_pago_enabled %}<span class="tc-available">Mercado Pago está habilitado en la tienda.</span>{% endif %}
        {% else %}
          <p class="tc-payment-note">Los medios de pago se muestran al configurar las opciones de pago de Shopify.</p>
        {% endif %}
      </article>
      <article class="tc-order-card"><div class="tc-card-top"><span class="tc-icon">✓</span><div><p>COMPRA INFORMADA</p><h3>Elegí antes de pagar.</h3></div></div><ol><li><b>1</b><span>Seleccionás Individual o Dúo.</span></li><li><b>2</b><span>Revisás el carrito y el total.</span></li><li><b>3</b><span>Confirmás la compra con el medio disponible.</span></li></ol></article>
    </div>

    <div class="tc-gift" data-tc-reveal>
      <div><p>PREPARADO PARA TU PRÓXIMO PRODUCTO</p><h2>Sumá un regalo cuando lo tengas listo.</h2><span>Este espacio queda configurado para mostrar un producto-regalo de forma clara, sin alterar la página principal.</span></div>
      {% if section.settings.gift_product != blank %}
        <a class="tc-gift-product" href="{{ section.settings.gift_product.url }}">{{ section.settings.gift_product.featured_image | image_url: width: 260 | image_tag: widths: '160, 260', loading: 'lazy', alt: section.settings.gift_product.title }}<span><small>Producto regalo</small><strong>{{ section.settings.gift_product.title | escape }}</strong><em>Ver regalo →</em></span></a>
      {% else %}
        <div class="tc-gift-empty"><span>＋</span><p>Cuando agregues el regalo en el editor del tema, aparecerá acá.</p></div>
      {% endif %}
    </div>
  </div>
</section>

{% stylesheet %}
  .tc-section{--ink:#16231d;--paper:#fafaf6;--muted:#66716b;--line:#dfe3dc;--lime:#c8e54a;background:var(--paper);color:var(--ink);font-family:inherit}.tc-wrap{width:min(1220px,calc(100% - 38px));margin:auto;padding:0 0 110px}.tc-heading{max-width:760px;margin:0 0 34px}.tc-heading>p,.tc-card-top p,.tc-gift p{margin:0 0 10px;color:#708c20;font-size:.72rem;font-weight:850;letter-spacing:.14em}.tc-heading h2,.tc-gift h2{margin:0;font-size:clamp(2.2rem,5vw,5rem);line-height:.98;letter-spacing:-.065em}.tc-heading>span,.tc-gift>div>span{display:block;max-width:570px;margin-top:19px;color:var(--muted);line-height:1.55}.tc-grid{display:grid;grid-template-columns:1fr 1fr;gap:13px}.tc-payment-card,.tc-order-card{padding:clamp(24px,4vw,44px);background:#eef1e9}.tc-order-card{background:var(--ink);color:#fff}.tc-card-top{display:flex;gap:14px;align-items:start}.tc-icon{display:grid;width:35px;height:35px;flex:0 0 35px;place-items:center;border-radius:50%;background:var(--lime);color:var(--ink);font-weight:900}.tc-card-top h3{max-width:300px;margin:0;font-size:clamp(1.35rem,2.5vw,2.1rem);line-height:1.02;letter-spacing:-.04em}.tc-payment-icons{display:flex;flex-wrap:wrap;gap:8px;margin-top:42px}.tc-payment-icon{width:50px;height:32px}.tc-payment-note{max-width:390px;margin:37px 0 0;color:var(--muted);line-height:1.5}.tc-available{display:block;margin-top:14px;color:#446720;font-size:.83rem;font-weight:750}.tc-order-card .tc-card-top p{color:var(--lime)}.tc-order-card ol{display:grid;gap:13px;padding:0;margin:40px 0 0;list-style:none}.tc-order-card li{display:flex;gap:11px;align-items:center;color:#dce4de;font-size:.9rem}.tc-order-card li b{display:grid;width:22px;height:22px;place-items:center;border:1px solid #718076;border-radius:50%;color:#fff;font-size:.7rem}.tc-gift{display:grid;grid-template-columns:1fr .9fr;gap:8vw;align-items:center;margin-top:80px;padding:50px 0;border-top:1px solid var(--line);border-bottom:1px solid var(--line)}.tc-gift-product{display:grid;grid-template-columns:120px 1fr;gap:18px;align-items:center;color:var(--ink);text-decoration:none}.tc-gift-product img{display:block;width:120px;height:120px;object-fit:cover;background:#edf0e8}.tc-gift-product span{display:grid;gap:6px}.tc-gift-product small{color:#708c20;font-weight:800;text-transform:uppercase}.tc-gift-product strong{font-size:1.1rem}.tc-gift-product em{color:var(--muted);font-size:.85rem;font-style:normal}.tc-gift-empty{display:flex;gap:13px;align-items:center;color:var(--muted);font-size:.9rem;line-height:1.45}.tc-gift-empty span{display:grid;width:34px;height:34px;place-items:center;border:1px solid var(--line);border-radius:50%;color:#708c20;font-size:1.2rem}.tc-gift-empty p{margin:0;color:var(--muted);font-size:.9rem;font-weight:400;letter-spacing:0;text-transform:none}.tc-section [data-tc-reveal]{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease}.tc-section [data-tc-reveal].is-visible{opacity:1;transform:none}@media(max-width:720px){.tc-wrap{width:min(100% - 24px,1220px);padding-bottom:75px}.tc-grid,.tc-gift{grid-template-columns:1fr}.tc-gift{gap:28px;margin-top:55px;padding:34px 0}.tc-payment-icons{margin-top:30px}}
{% endstylesheet %}
{% javascript %}
  const confidenceObserver = new IntersectionObserver((entries) => { entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); confidenceObserver.unobserve(entry.target); } }); }, { threshold: .12 }); document.querySelectorAll('.tc-section [data-tc-reveal]').forEach((element) => confidenceObserver.observe(element));
{% endjavascript %}
{% schema %}
{"name":"Compra con confianza","tag":"section","class":"section-tienda-confianza","settings":[{"type":"product","id":"gift_product","label":"Producto regalo"}],"presets":[{"name":"Compra con confianza"}]}
{% endschema %}
