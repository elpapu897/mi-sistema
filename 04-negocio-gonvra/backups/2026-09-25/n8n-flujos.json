      {
        "parameters": {
          "jsCode": "// Arma el aviso de venta con todo lo que hace falta para despachar.\nconst o = $input.first().json.body || $input.first().json || {};\n\nconst fmt = n => '$' + Number(n || 0).toLocaleString('es-AR', {minimumFractionDigits: 2});\nconst cli = o.customer || {};\nconst env = o.shipping_address || {};\nconst nombre = [cli.first_name, cli.last_name].filter(Boolean).join(' ')\n             || [env.first_name, env.last_name].filter(Boolean).join(' ')\n             || 'sin nombre';\n\nconst items = (o.line_items || [])\n  .map(li => `  ${li.quantity}x ${li.title} - ${fmt(li.price)}`).join('\\n');\n\nconst lineas = [\n  'VENTA EN GONVRA',\n  '',\n  `Pedido #${o.order_number || o.name || '?'}  -  ${fmt(o.total_price)}`,\n  `Pago: ${o.financial_status || '?'}`,\n  '',\n  'CLIENTE',\n  `  ${nombre}`,\n  `  ${o.email || 'sin mail'}`,\n  `  ${o.phone || env.phone || 'sin telefono'}`,\n  '',\n  'ENVIAR A',\n  `  ${env.address1 || ''} ${env.address2 || ''}`.trim(),\n  `  ${env.city || ''}, ${env.province || ''} (${env.zip || ''})`,\n  '',\n  'COMPRO',\n  items || '  (sin detalle)',\n  '',\n  'Entra a Shopify y despachalo.'\n];\n\nreturn [{ json: { texto: lineas.join('\\n') } }];"
        },
        "id": "code-venta",
