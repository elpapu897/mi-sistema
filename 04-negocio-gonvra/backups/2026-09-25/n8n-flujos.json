      {
        "parameters": {
          "jsCode": "// Busca comentarios que contengan una palabra clave de compra.\n// Solo esos disparan el mensaje privado. El resto se ignora.\nconst CLAVES = ['precio', 'cuanto', 'cuánto', 'info', 'quiero', 'comprar', 'valor', 'link'];\n\nconst body = $input.first().json.body || {};\nconst salida = [];\n\nfor (const entrada of (body.entry || [])) {\n  for (const cambio of (entrada.changes || [])) {\n    if (cambio.field !== 'comments') continue;\n    const v = cambio.value || {};\n    const texto = (v.text || '').toLowerCase();\n    const autor = (v.from && v.from.username) || '';\n    const autorId = (v.from && v.from.id) || '';\n    const comentarioId = v.id || '';\n\n    // no responderse a si mismo\n    if (autor === 'gonvra1') continue;\n    if (!CLAVES.some(k => texto.includes(k))) continue;\n\n    salida.push({ json: {\n      comentario_id: comentarioId,\n      autor,\n      autor_id: autorId,\n      texto: v.text || ''\n    }});\n  }\n}\n\nreturn salida;"
        },
