{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background }};
  }
  #shopify-section-{{ section.id }} .mt-steps { background: {{ section.settings.background }}; }
  #shopify-section-{{ section.id }} .mt-steps__head { text-align: {{ section.settings.text_align }}; }
  #shopify-section-{{ section.id }} .mt-steps__head .mt-h2 { font-size: clamp(36px, 5vw, {{ section.settings.heading_size }}px); }
  #shopify-section-{{ section.id }} .mt-steps__head .mt-body { font-size: clamp(15px, 1.35vw, {{ section.settings.body_size }}px); }
  #shopify-section-{{ section.id }} .mt-steps__grid { gap: {{ section.settings.gap }}px; }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} { padding-top: min({{ section.settings.padding_top }}px, 72px); padding-bottom: min({{ section.settings.padding_bottom }}px, 72px); }
  }
{% endstyle %}

<section class="mt-steps mt-section" id="como-funciona">
  <div class="mt-container">
    <header class="mt-steps__head">
      <div class="mt-steps__head-copy">
        {%- if section.settings.kicker != blank -%}<p class="mt-kicker mt-reveal">{{ section.settings.kicker }}</p>{%- endif -%}
        <h2 class="mt-h2 mt-reveal">{{ section.settings.headline }}</h2>
      </div>
      {%- if section.settings.body != blank -%}<div class="mt-body mt-reveal">{{ section.settings.body | newline_to_br }}</div>{%- endif -%}
    </header>

    <div class="mt-steps__grid mt-stagger">
      {%- for block in section.blocks -%}
        {%- liquid
          case forloop.index
            when 1
              assign fallback_image = 'mt-paso-carga.webp'
            when 2
              assign fallback_image = 'mt-paso-afeitado.webp'
            else
              assign fallback_image = 'mt-paso-limpieza.webp'
          endcase
        -%}
        <article class="mt-step-card mt-reveal" {{ block.shopify_attributes }}>
          <div class="mt-step-card__media">
            <span class="mt-step-card__number">{{ block.settings.number }}</span>
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 1100 }}" alt="{{ block.settings.image.alt | default: block.settings.title | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
            {%- else -%}
              <img src="{{ fallback_image | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="1122" height="1402">
            {%- endif -%}
          </div>
          <div class="mt-step-card__copy" style="text-align: {{ block.settings.text_align }};">
            <h3 class="mt-h3" style="font-size: {{ block.settings.title_size }}px;">{{ block.settings.title }}</h3>
            <p style="font-size: {{ block.settings.body_size }}px;">{{ block.settings.body | newline_to_br }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MT – Uso en tres pasos",
  "tag": "section",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Antetítulo", "default": "TU RUTINA, SIMPLIFICADA" },
    { "type": "text", "id": "headline", "label": "Título", "default": "Lista en tres movimientos." },
    { "type": "textarea", "id": "body", "label": "Texto", "default": "Cargá, afeitá y limpiá. Sin una rutina complicada ni accesorios innecesarios." },
    { "type": "select", "id": "text_align", "label": "Alineación", "options": [{"value":"left","label":"Izquierda"},{"value":"center","label":"Centro"},{"value":"right","label":"Derecha"}], "default": "left" },
    { "type": "range", "id": "heading_size", "label": "Tamaño del título (px)", "min": 34, "max": 80, "step": 2, "unit": "px", "default": 62 },
    { "type": "range", "id": "body_size", "label": "Tamaño del texto (px)", "min": 14, "max": 24, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "gap", "label": "Separación entre tarjetas (px)", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 20 },
    { "type": "color", "id": "background", "label": "Color de fondo", "default": "#EDF2F6" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 128 }
  ],
  "blocks": [
    {
      "type": "paso",
      "name": "Paso",
      "settings": [
        { "type": "text", "id": "number", "label": "Número", "default": "01" },
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "title", "label": "Título", "default": "Cargá" },
        { "type": "textarea", "id": "body", "label": "Texto", "default": "Conectala por USB y controlá el estado desde su indicador frontal." },
        { "type": "select", "id": "text_align", "label": "Alineación", "options": [{"value":"left","label":"Izquierda"},{"value":"center","label":"Centro"},{"value":"right","label":"Derecha"}], "default": "left" },
        { "type": "range", "id": "title_size", "label": "Tamaño del título (px)", "min": 20, "max": 38, "step": 1, "unit": "px", "default": 28 },
        { "type": "range", "id": "body_size", "label": "Tamaño del texto (px)", "min": 13, "max": 21, "step": 1, "unit": "px", "default": 15 }
      ]
    }
  ],
  "presets": [{ "name": "MT – Uso en tres pasos", "blocks": [{"type":"paso"},{"type":"paso"},{"type":"paso"}] }]
}
{% endschema %}
