{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background }};
  }
  #shopify-section-{{ section.id }} .mt-benefits { background: {{ section.settings.background }}; }
  #shopify-section-{{ section.id }} .mt-benefits__intro { text-align: {{ section.settings.text_align }}; }
  #shopify-section-{{ section.id }} .mt-benefits__intro .mt-h2 { font-size: clamp(36px, 5vw, {{ section.settings.heading_size }}px); }
  #shopify-section-{{ section.id }} .mt-benefits__intro .mt-body { font-size: clamp(15px, 1.35vw, {{ section.settings.body_size }}px); }
  #shopify-section-{{ section.id }} .mt-benefits__grid { gap: {{ section.settings.gap }}px; }
  #shopify-section-{{ section.id }} .mt-benefit-card { min-height: {{ section.settings.card_height }}px; }
  @media (max-width: 990px) {
    #shopify-section-{{ section.id }} .mt-benefit-card { min-height: 620px; }
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} { padding-top: min({{ section.settings.padding_top }}px, 72px); padding-bottom: min({{ section.settings.padding_bottom }}px, 72px); }
  }
  @media (max-width: 540px) {
    #shopify-section-{{ section.id }} .mt-benefit-card { min-height: 520px; }
  }
{% endstyle %}

<section class="mt-benefits mt-section" id="beneficios">
  <div class="mt-container">
    <header class="mt-benefits__intro">
      {%- if section.settings.kicker != blank -%}<p class="mt-kicker mt-reveal">{{ section.settings.kicker }}</p>{%- endif -%}
      <h2 class="mt-h2 mt-reveal">{{ section.settings.headline }}</h2>
      {%- if section.settings.body != blank -%}<div class="mt-body mt-reveal">{{ section.settings.body | newline_to_br }}</div>{%- endif -%}
    </header>

    <div class="mt-benefits__grid mt-stagger">
      {%- for block in section.blocks -%}
        {%- liquid
          case forloop.index
            when 1
              assign fallback_image = 'mt-macro-cabezales.webp'
              assign fallback_width = 1254
              assign fallback_height = 1254
            when 2
              assign fallback_image = 'mt-viaje.webp'
              assign fallback_width = 1122
              assign fallback_height = 1402
            else
              assign fallback_image = 'mt-catalogo-plata-lateral.webp'
              assign fallback_width = 1254
              assign fallback_height = 1254
          endcase
        -%}
        <article class="mt-benefit-card mt-reveal" data-mt-tilt="{{ section.settings.tilt }}" {{ block.shopify_attributes }}>
          <div class="mt-benefit-card__media">
            {%- if block.settings.image != blank -%}
              <img src="{{ block.settings.image | image_url: width: 1200 }}" alt="{{ block.settings.image.alt | default: block.settings.title | escape }}" loading="lazy" width="{{ block.settings.image.width }}" height="{{ block.settings.image.height }}">
            {%- else -%}
              <img src="{{ fallback_image | asset_url }}" alt="{{ block.settings.title | escape }}" loading="lazy" width="{{ fallback_width }}" height="{{ fallback_height }}">
            {%- endif -%}
          </div>
          <div class="mt-benefit-card__shade"></div>
          <div class="mt-benefit-card__copy" style="text-align: {{ block.settings.text_align }};">
            <span class="mt-benefit-card__num">0{{ forloop.index }} / 03</span>
            <h3 class="mt-h3" style="font-size: {{ block.settings.title_size }}px;">{{ block.settings.title }}</h3>
            <p style="font-size: {{ block.settings.body_size }}px;">{{ block.settings.body | newline_to_br }}</p>
          </div>
        </article>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MT – Beneficios visuales",
  "tag": "section",
  "max_blocks": 3,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Antetítulo", "default": "MÁS CAPACIDAD, MENOS VOLUMEN" },
    { "type": "text", "id": "headline", "label": "Título", "default": "Todo lo que necesitás. Nada que sobre." },
    { "type": "textarea", "id": "body", "label": "Texto", "default": "Diseñada para simplificar los retoques cotidianos en un formato fácil de usar y de llevar." },
    { "type": "select", "id": "text_align", "label": "Alineación del encabezado", "options": [{"value":"left","label":"Izquierda"},{"value":"center","label":"Centro"},{"value":"right","label":"Derecha"}], "default": "center" },
    { "type": "range", "id": "heading_size", "label": "Tamaño del título (px)", "min": 32, "max": 80, "step": 2, "unit": "px", "default": 62 },
    { "type": "range", "id": "body_size", "label": "Tamaño del texto (px)", "min": 14, "max": 24, "step": 1, "unit": "px", "default": 18 },
    { "type": "range", "id": "card_height", "label": "Altura de tarjetas (px)", "min": 420, "max": 660, "step": 20, "unit": "px", "default": 540 },
    { "type": "range", "id": "gap", "label": "Separación entre tarjetas (px)", "min": 8, "max": 40, "step": 2, "unit": "px", "default": 22 },
    { "type": "range", "id": "tilt", "label": "Inclinación al mover el cursor", "min": 0, "max": 12, "step": 1, "default": 5 },
    { "type": "color", "id": "background", "label": "Color de fondo", "default": "#F7FAFC" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 112 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 128 }
  ],
  "blocks": [
    {
      "type": "beneficio",
      "name": "Beneficio",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "Imagen" },
        { "type": "text", "id": "title", "label": "Título", "default": "Doble cabezal en formato mini" },
        { "type": "textarea", "id": "body", "label": "Texto", "default": "Dos superficies circulares de corte dentro de un cuerpo compacto." },
        { "type": "select", "id": "text_align", "label": "Alineación", "options": [{"value":"left","label":"Izquierda"},{"value":"center","label":"Centro"},{"value":"right","label":"Derecha"}], "default": "left" },
        { "type": "range", "id": "title_size", "label": "Tamaño del título (px)", "min": 20, "max": 40, "step": 1, "unit": "px", "default": 28 },
        { "type": "range", "id": "body_size", "label": "Tamaño del texto (px)", "min": 13, "max": 22, "step": 1, "unit": "px", "default": 16 }
      ]
    }
  ],
  "presets": [{ "name": "MT – Beneficios visuales", "blocks": [{"type":"beneficio"},{"type":"beneficio"},{"type":"beneficio"}] }]
}
{% endschema %}
