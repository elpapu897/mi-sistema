{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background }};
  }
  #shopify-section-{{ section.id }} .mt-cta {
    min-height: {{ section.settings.min_height }}px;
    --mt-cta-position: {{ section.settings.image_position }};
  }
  #shopify-section-{{ section.id }} .mt-cta__content { text-align: {{ section.settings.text_align }}; }
  #shopify-section-{{ section.id }} .mt-cta__content .mt-h2 { font-size: clamp(36px, 5vw, {{ section.settings.heading_size }}px); }
  #shopify-section-{{ section.id }} .mt-cta__content .mt-body { font-size: clamp(15px, 1.35vw, {{ section.settings.body_size }}px); }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} { padding-top: min({{ section.settings.padding_top }}px, 72px); padding-bottom: min({{ section.settings.padding_bottom }}px, 72px); }
    #shopify-section-{{ section.id }} .mt-cta { min-height: 640px; }
  }
{% endstyle %}

<section class="mt-cta mt-section">
  <div class="mt-cta__media" aria-hidden="true">
    {%- if section.settings.image != blank -%}
      <img src="{{ section.settings.image | image_url: width: 2400 }}" alt="" loading="lazy" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}">
    {%- else -%}
      <img src="{{ 'mt-cta-wide.webp' | asset_url }}" alt="" loading="lazy" width="2012" height="781">
    {%- endif -%}
  </div>
  <div class="mt-container">
    <div class="mt-cta__content mt-reveal">
      {%- if section.settings.kicker != blank -%}<p class="mt-kicker">{{ section.settings.kicker }}</p>{%- endif -%}
      <h2 class="mt-h2">{{ section.settings.headline }}</h2>
      {%- if section.settings.body != blank -%}<div class="mt-body">{{ section.settings.body | newline_to_br }}</div>{%- endif -%}
      {%- if section.settings.button_label != blank -%}
        <a class="mt-btn mt-btn--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">
          {{ section.settings.button_label }}
          <svg viewBox="0 0 20 20" aria-hidden="true"><path d="M4 10h11M11 5l5 5-5 5" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round"/></svg>
        </a>
      {%- endif -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MT – Cierre de compra",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen panorámica" },
    { "type": "select", "id": "image_position", "label": "Posición de la imagen", "options": [{"value":"center center","label":"Centro"},{"value":"left center","label":"Izquierda"},{"value":"right center","label":"Derecha"}], "default": "center center" },
    { "type": "range", "id": "min_height", "label": "Altura mínima (px)", "min": 420, "max": 700, "step": 20, "unit": "px", "default": 560 },
    { "type": "text", "id": "kicker", "label": "Antetítulo", "default": "MENOS TIEMPO. MÁS PROLIJO." },
    { "type": "text", "id": "headline", "label": "Título", "default": "Tu próximo afeitado cabe en la mano." },
    { "type": "textarea", "id": "body", "label": "Texto", "default": "Elegí tu color y llevá tu rutina de afeitado a cualquier parte." },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Comprar Helio Mini" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" },
    { "type": "select", "id": "text_align", "label": "Alineación", "options": [{"value":"left","label":"Izquierda"},{"value":"center","label":"Centro"},{"value":"right","label":"Derecha"}], "default": "left" },
    { "type": "range", "id": "heading_size", "label": "Tamaño del título (px)", "min": 34, "max": 84, "step": 2, "unit": "px", "default": 64 },
    { "type": "range", "id": "body_size", "label": "Tamaño del texto (px)", "min": 14, "max": 24, "step": 1, "unit": "px", "default": 18 },
    { "type": "color", "id": "background", "label": "Color de respaldo", "default": "#080A0F" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 0 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 0 }
  ],
  "presets": [{ "name": "MT – Cierre de compra" }]
}
{% endschema %}
