{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background }};
  }
  #shopify-section-{{ section.id }} .mt-lifestyle { background: {{ section.settings.background }}; }
  #shopify-section-{{ section.id }} .mt-lifestyle__copy { text-align: {{ section.settings.text_align }}; }
  #shopify-section-{{ section.id }} .mt-lifestyle__copy .mt-h2 { font-size: clamp(36px, 5vw, {{ section.settings.heading_size }}px); }
  #shopify-section-{{ section.id }} .mt-lifestyle__copy .mt-body { font-size: clamp(15px, 1.35vw, {{ section.settings.body_size }}px); }
  {% if section.settings.reverse %}
    #shopify-section-{{ section.id }} .mt-lifestyle__media { order: 2; }
    #shopify-section-{{ section.id }} .mt-lifestyle__copy { order: 1; }
  {% endif %}
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} { padding-top: min({{ section.settings.padding_top }}px, 72px); padding-bottom: min({{ section.settings.padding_bottom }}px, 72px); }
    #shopify-section-{{ section.id }} .mt-lifestyle__media,
    #shopify-section-{{ section.id }} .mt-lifestyle__copy { order: initial; }
  }
{% endstyle %}

<section class="mt-lifestyle mt-section">
  <div class="mt-container">
    <div class="mt-lifestyle__frame mt-reveal">
      <div class="mt-lifestyle__media">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 1600 }}" alt="{{ section.settings.image.alt | default: section.settings.image_alt | escape }}" loading="lazy" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}">
        {%- else -%}
          <img src="{{ 'mt-viaje.webp' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" loading="lazy" width="1122" height="1402">
        {%- endif -%}
      </div>
      <div class="mt-lifestyle__copy">
        {%- if section.settings.kicker != blank -%}<p class="mt-kicker">{{ section.settings.kicker }}</p>{%- endif -%}
        <h2 class="mt-h2">{{ section.settings.headline }}</h2>
        {%- if section.settings.body != blank -%}<div class="mt-body">{{ section.settings.body | newline_to_br }}</div>{%- endif -%}
        <ul class="mt-lifestyle__checks">
          {%- for i in (1..3) -%}
            {%- assign check_key = 'check_' | append: i -%}
            {%- if section.settings[check_key] != blank -%}<li>{{ section.settings[check_key] }}</li>{%- endif -%}
          {%- endfor -%}
        </ul>
        {%- if section.settings.button_label != blank -%}<a class="mt-btn mt-btn--primary" href="{{ section.settings.button_link | default: routes.all_products_collection_url }}">{{ section.settings.button_label }}</a>{%- endif -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MT – Escena de viaje",
  "tag": "section",
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen" },
    { "type": "text", "id": "image_alt", "label": "Descripción accesible", "default": "Afeitadora Helio Mini junto a objetos de viaje" },
    { "type": "checkbox", "id": "reverse", "label": "Mostrar imagen a la derecha", "default": false },
    { "type": "text", "id": "kicker", "label": "Antetítulo", "default": "HECHA PARA MOVERSE" },
    { "type": "text", "id": "headline", "label": "Título", "default": "Tu rutina no ocupa lugar." },
    { "type": "textarea", "id": "body", "label": "Texto", "default": "En el baño de casa, en el neceser o en una habitación de hotel: Helio Mini está pensada para estar lista sin cargar con más de la cuenta." },
    { "type": "text", "id": "check_1", "label": "Punto 1", "default": "Formato compacto para bolso o neceser" },
    { "type": "text", "id": "check_2", "label": "Punto 2", "default": "Carga USB fácil de encontrar" },
    { "type": "text", "id": "check_3", "label": "Punto 3", "default": "Limpieza rápida después de usar" },
    { "type": "text", "id": "button_label", "label": "Texto del botón", "default": "Quiero la mía" },
    { "type": "url", "id": "button_link", "label": "Enlace del botón" },
    { "type": "select", "id": "text_align", "label": "Alineación", "options": [{"value":"left","label":"Izquierda"},{"value":"center","label":"Centro"},{"value":"right","label":"Derecha"}], "default": "left" },
    { "type": "range", "id": "heading_size", "label": "Tamaño del título (px)", "min": 34, "max": 80, "step": 2, "unit": "px", "default": 60 },
    { "type": "range", "id": "body_size", "label": "Tamaño del texto (px)", "min": 14, "max": 24, "step": 1, "unit": "px", "default": 17 },
    { "type": "color", "id": "background", "label": "Color de fondo exterior", "default": "#F7FAFC" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 112 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 120 }
  ],
  "presets": [{ "name": "MT – Escena de viaje" }]
}
{% endschema %}
