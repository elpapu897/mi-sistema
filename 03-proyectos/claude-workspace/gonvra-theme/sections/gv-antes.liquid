{%- if section.settings.wave -%}
  {% render 'gv-wave', from: section.settings.wave_from, fill: '#101a16', accent: '#c8e54a', uid: section.id %}
{%- endif -%}

<section class="gva" data-gva>
  <div class="gva-wrap">
    <header class="gva-head" data-gva-reveal>
      {% if section.settings.kicker != blank %}<p class="gva-kicker">{{ section.settings.kicker }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.sub != blank %}<p class="gva-sub">{{ section.settings.sub }}</p>{% endif %}
    </header>

    <div class="gva-body">
      <div class="gva-slider" data-gva-slider style="--pos:50%">
        {% if section.settings.after != blank %}
          {{ section.settings.after | image_url: width: 1400 | image_tag: widths: '480, 760, 1100, 1400', sizes: '(min-width: 900px) 58vw, 100vw', loading: 'lazy', alt: 'Después del recorte', class: 'gva-img' }}
        {% else %}
          <img class="gva-img" src="{{ 'gv-despues.jpg' | asset_url }}" width="1100" height="1375" loading="lazy" alt="Después del recorte">
        {% endif %}

        <div class="gva-before">
          {% if section.settings.before != blank %}
            {{ section.settings.before | image_url: width: 1400 | image_tag: widths: '480, 760, 1100, 1400', sizes: '(min-width: 900px) 58vw, 100vw', loading: 'lazy', alt: 'Antes del recorte', class: 'gva-img' }}
          {% else %}
            <img class="gva-img" src="{{ 'gv-antes.jpg' | asset_url }}" width="1100" height="1375" loading="lazy" alt="Antes del recorte">
          {% endif %}
        </div>

        <b class="gva-tag gva-tag--a">{{ section.settings.label_before }}</b>
        <b class="gva-tag gva-tag--b">{{ section.settings.label_after }}</b>
        <span class="gva-handle" aria-hidden="true"><i></i></span>
        <input type="range" min="0" max="100" value="50" aria-label="Deslizá para comparar antes y después">
      </div>

      <div class="gva-copy" data-gva-reveal>
        {% for block in section.blocks %}
          <div class="gva-item" {{ block.shopify_attributes }}>
            <strong>{{ block.settings.title }}</strong>
            <p>{{ block.settings.text }}</p>
          </div>
        {% endfor %}
        {% if section.settings.cta_text != blank %}
          <a class="gva-cta" href="{{ section.settings.cta_link | default: '#comprar' }}">{{ section.settings.cta_text }}</a>
        {% endif %}
      </div>
    </div>

    {% if section.settings.foot != blank %}<p class="gva-foot" data-gva-reveal>{{ section.settings.foot }}</p>{% endif %}
  </div>
  {%- if section.settings.wave_bottom -%}
    <div class="gva-wavebot">{% render 'gv-wave', from: '#101a16', fill: section.settings.wave_to, accent: '#dff0a8', uid: section.id %}</div>
  {%- endif -%}
</section>

{% stylesheet %}
.gvw{position:relative;line-height:0;margin-bottom:-2px;overflow:hidden}
.gvw-svg{display:block;width:100%;height:clamp(52px,7vw,110px)}
.gvw-p{will-change:transform}
.gvw-p1{opacity:.34;animation:gvw-slide 19s linear infinite}
.gvw-p2{opacity:.55;animation:gvw-slide 13s linear infinite reverse}
.gvw-p3{animation:gvw-slide 26s linear infinite}
@keyframes gvw-slide{from{transform:translateX(0)}to{transform:translateX(-1440px)}}
@media (prefers-reduced-motion:reduce){.gvw-p{animation:none}}
.gva{background:#101a16;color:#f4f5ef;font-family:inherit}
.gva-wavebot{margin-top:clamp(30px,4vw,56px)}
.gva-wavebot .gvw{margin-bottom:-6px}
.gva-wrap{width:min(1280px,calc(100% - 36px));margin:auto;padding:clamp(56px,7vw,100px) 0}
.gva-head{max-width:56ch}
.gva-kicker{margin:0 0 11px;color:#c8e54a;font-size:.68rem;font-weight:850;letter-spacing:.16em;text-transform:uppercase}
.gva-head h2{margin:0;font-size:clamp(1.7rem,3.6vw,3rem);line-height:1.05;letter-spacing:-.035em}
.gva-sub{max-width:52ch;margin:14px 0 0;color:#a3ae9f;font-size:.95rem;line-height:1.6}
.gva-body{display:grid;grid-template-columns:1.25fr .75fr;gap:clamp(24px,4vw,60px);align-items:center;margin:clamp(30px,4vw,52px) 0 0}
.gva-slider{position:relative;overflow:hidden;border-radius:18px;background:#1a2620;aspect-ratio:4/5;cursor:ew-resize;touch-action:pan-y}
.gva-img{display:block;width:100%;height:100%;object-fit:cover}
.gva-slider>.gva-img{position:absolute;inset:0}
.gva-before{position:absolute;inset:0;width:var(--pos);overflow:hidden}
.gva-before .gva-img{position:absolute;top:0;left:0;width:var(--w,100%);height:100%;max-width:none}
.gva-tag{position:absolute;top:14px;z-index:2;padding:7px 12px;border-radius:999px;background:rgba(16,26,22,.86);color:#fff;font-size:.66rem;font-weight:800;letter-spacing:.11em;text-transform:uppercase;backdrop-filter:blur(4px)}
.gva-tag--a{left:14px}
.gva-tag--b{right:14px;background:rgba(200,229,74,.92);color:#1d2708}
.gva-handle{position:absolute;top:0;bottom:0;left:var(--pos);z-index:3;width:2px;background:rgba(255,255,255,.9);transform:translateX(-1px);pointer-events:none}
.gva-handle i{position:absolute;top:50%;left:50%;display:block;width:44px;height:44px;border:2px solid #fff;border-radius:50%;background:rgba(16,26,22,.72);transform:translate(-50%,-50%);backdrop-filter:blur(5px)}
.gva-handle i::before,.gva-handle i::after{content:"";position:absolute;top:50%;width:0;height:0;border:5px solid transparent;transform:translateY(-50%)}
.gva-handle i::before{left:7px;border-right-color:#fff}
.gva-handle i::after{right:7px;border-left-color:#fff}
.gva-slider input{position:absolute;z-index:4;inset:0;width:100%;height:100%;margin:0;opacity:0;cursor:ew-resize}
.gva-copy{display:grid;gap:20px;align-content:center}
.gva-item strong{display:block;margin-bottom:5px;font-size:1rem}
.gva-item p{margin:0;color:#9daa9c;font-size:.88rem;line-height:1.6}
.gva-cta{justify-self:start;padding:16px 28px;border-radius:12px;background:#c8e54a;color:#1b2410;font-size:.78rem;font-weight:850;letter-spacing:.13em;text-transform:uppercase;text-decoration:none;transition:transform .18s}
.gva-cta:hover{transform:translateY(-2px)}
.gva-foot{margin:clamp(24px,3vw,38px) 0 0;color:#7c8a7c;font-size:.72rem;line-height:1.5}
.gva [data-gva-reveal]{opacity:0;transform:translateY(22px);transition:opacity .7s ease,transform .7s ease}
.gva [data-gva-reveal].is-in{opacity:1;transform:none}
@media(max-width:860px){
.gva-wrap{width:min(100% - 24px,1280px)}
.gva-body{grid-template-columns:1fr;gap:22px}
.gva-cta{justify-self:stretch;text-align:center}
}
{% endstylesheet %}

{% javascript %}
(() => {
  document.querySelectorAll('[data-gva]').forEach((root) => {
    root.querySelectorAll('[data-gva-slider]').forEach((slider) => {
      const input = slider.querySelector('input');
      const before = slider.querySelector('.gva-before .gva-img');
      const sync = () => {
        slider.style.setProperty('--pos', input.value + '%');
        if (before) before.style.setProperty('--w', slider.clientWidth + 'px');
      };
      input.addEventListener('input', sync);
      window.addEventListener('resize', sync);
      sync();
      // barrido de presentación la primera vez que se ve
      const io = new IntersectionObserver((entries) => {
        entries.forEach((e) => {
          if (!e.isIntersecting || slider.dataset.shown) return;
          slider.dataset.shown = '1';
          io.unobserve(slider);
          let v = 50, dir = 1, steps = 0;
          const run = setInterval(() => {
            steps++; v += dir * 2.2;
            if (v >= 74) dir = -1;
            if (v <= 30) dir = 1;
            input.value = v; sync();
            if (steps > 58) { clearInterval(run); input.value = 50; sync(); }
          }, 16);
        });
      }, { threshold: .4 });
      io.observe(slider);
    });
    const reveal = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); reveal.unobserve(e.target); } });
    }, { threshold: .12 });
    root.querySelectorAll('[data-gva-reveal]').forEach((el) => reveal.observe(el));
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "GONVRA · Antes y después",
  "tag": "section",
  "class": "section-gv-antes",
  "settings": [
    { "type": "checkbox", "id": "wave", "label": "Ola de transición arriba", "default": true },
    { "type": "color", "id": "wave_from", "label": "Color de la sección de arriba", "default": "#f7f6f1" },
    { "type": "checkbox", "id": "wave_bottom", "label": "Ola abajo", "default": true },
    { "type": "color", "id": "wave_to", "label": "Color de la sección de abajo", "default": "#f7f6f1" },
    { "type": "text", "id": "kicker", "label": "Bajada corta", "default": "Antes y después" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Deslizá y mirá la diferencia" },
    { "type": "text", "id": "sub", "label": "Bajada", "default": "Movés la línea con el dedo para ver cómo queda la zona antes y después de pasar la rasuradora." },
    { "type": "image_picker", "id": "before", "label": "Foto ANTES" },
    { "type": "image_picker", "id": "after", "label": "Foto DESPUÉS" },
    { "type": "text", "id": "label_before", "label": "Etiqueta izquierda", "default": "Antes" },
    { "type": "text", "id": "label_after", "label": "Etiqueta derecha", "default": "Después" },
    { "type": "text", "id": "cta_text", "label": "Botón", "default": "Quiero probarla" },
    { "type": "url", "id": "cta_link", "label": "Link del botón" },
    { "type": "text", "id": "foot", "label": "Nota al pie", "default": "Imágenes ilustrativas del uso del producto. El resultado es temporal y varía según el tipo y grosor del vello." }
  ],
  "blocks": [
    {
      "type": "punto",
      "name": "Punto",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "En una sola pasada" },
        { "type": "textarea", "id": "text", "label": "Texto", "default": "Contá acá qué se nota." }
      ]
    }
  ],
  "presets": [
    {
      "name": "GONVRA · Antes y después",
      "blocks": [
        { "type": "punto", "settings": { "title": "Sin espuma ni gel", "text": "Se usa en seco: apoyás, deslizás y listo. No hace falta preparar la piel." } },
        { "type": "punto", "settings": { "title": "El largo lo elegís vos", "text": "Con peine queda parejo al largo que elijas; sin peine, el acabado es más al ras." } },
        { "type": "punto", "settings": { "title": "Rostro y cuerpo", "text": "La misma máquina para la barba, el pecho, los brazos y las piernas." } }
      ]
    }
  ]
}
{% endschema %}
