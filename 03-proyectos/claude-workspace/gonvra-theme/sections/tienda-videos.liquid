{% liquid
  assign video_count = 0
  for block in section.blocks
    if block.settings.video != blank
      assign video_count = video_count | plus: 1
    endif
  endfor
%}

{% if video_count > 0 %}
  <section class="tv-section">
    <div class="tv-wrap">
      <div class="tv-heading" data-tv-reveal><p>EN MOVIMIENTO</p><h2>Mirá la rasuradora en uso.</h2><span>Videos de demostración cargados por la tienda.</span></div>
      <div class="tv-grid">
        {% for block in section.blocks %}
          {% if block.settings.video != blank %}
            <article class="tv-card" data-tv-reveal {{ block.shopify_attributes }}>
              {{ block.settings.video | video_tag: controls: true, muted: true, playsinline: true, preload: 'metadata' }}
              {% if block.settings.heading != blank %}<h3>{{ block.settings.heading | escape }}</h3>{% endif %}
            </article>
          {% endif %}
        {% endfor %}
      </div>
    </div>
  </section>
{% endif %}

{% stylesheet %}
  .tv-section{--ink:#16231d;--paper:#fafaf6;--muted:#66716b;--line:#dfe3dc;background:var(--paper);color:var(--ink);font-family:inherit}.tv-wrap{width:min(1220px,calc(100% - 38px));margin:auto;padding:0 0 110px}.tv-heading{display:flex;align-items:end;justify-content:space-between;gap:40px;margin:0 0 35px;padding-top:20px;border-top:1px solid var(--ink)}.tv-heading p{margin:0 0 11px;color:#708c20;font-size:.72rem;font-weight:850;letter-spacing:.14em}.tv-heading h2{margin:0;font-size:clamp(2.2rem,5vw,5rem);line-height:.98;letter-spacing:-.065em}.tv-heading span{max-width:290px;color:var(--muted);line-height:1.5}.tv-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:12px}.tv-card{overflow:hidden;background:#edf0e8}.tv-card video{display:block;width:100%;aspect-ratio:9/16;object-fit:cover;background:#16231d}.tv-card h3{margin:0;padding:15px 16px 17px;font-size:.95rem}.tv-section [data-tv-reveal]{opacity:0;transform:translateY(24px);transition:opacity .7s ease,transform .7s ease}.tv-section [data-tv-reveal].is-visible{opacity:1;transform:none}@media(max-width:720px){.tv-wrap{width:min(100% - 24px,1220px);padding-bottom:75px}.tv-heading{align-items:start;flex-direction:column;gap:17px}.tv-grid{grid-template-columns:repeat(3,minmax(210px,1fr));overflow-x:auto;padding-bottom:8px}.tv-card{min-width:210px}}
{% endstylesheet %}

{% javascript %}
  const videoObserver = new IntersectionObserver((entries) => { entries.forEach((entry) => { if (entry.isIntersecting) { entry.target.classList.add('is-visible'); videoObserver.unobserve(entry.target); } }); }, { threshold: .12 }); document.querySelectorAll('.tv-section [data-tv-reveal]').forEach((element) => videoObserver.observe(element));
{% endjavascript %}

{% schema %}
{"name":"Videos de producto","tag":"section","class":"section-tienda-videos","max_blocks":3,"blocks":[{"type":"video","name":"Video","settings":[{"type":"video","id":"video","label":"Video"},{"type":"text","id":"heading","label":"Título del video"}]}],"presets":[{"name":"Videos de producto","blocks":[{"type":"video"},{"type":"video"},{"type":"video"}]}]}
{% endschema %}
