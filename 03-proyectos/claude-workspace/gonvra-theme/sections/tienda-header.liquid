<div class="ts-chrome">
  <div class="ts-marquee" aria-label="Características de la rasuradora">
    <div class="ts-marquee__track">
      <span>RASURADORA INTEGRAL</span><i aria-hidden="true">✦</i><span>RECARGABLE POR USB</span><i aria-hidden="true">✦</i><span>PEINES DE 1, 3 Y 5 MM</span><i aria-hidden="true">✦</i><span>ROSTRO + CUERPO</span>
      <span aria-hidden="true">RASURADORA INTEGRAL</span><i aria-hidden="true">✦</i><span aria-hidden="true">RECARGABLE POR USB</span><i aria-hidden="true">✦</i><span aria-hidden="true">PEINES DE 1, 3 Y 5 MM</span><i aria-hidden="true">✦</i><span aria-hidden="true">ROSTRO + CUERPO</span>
    </div>
  </div>
  <header class="ts-header">
    <div class="ts-header__inner">
      <a class="ts-header__home" href="{{ routes.root_url }}">Inicio</a>
      <nav aria-label="Navegación principal"><a href="{{ routes.root_url }}">Inicio</a><a href="/products/face-body-electric-shaver">Catálogo</a></nav>
      <a class="ts-header__catalog" href="/products/face-body-electric-shaver">Ver rasuradora <span aria-hidden="true">↗</span></a>
    </div>
  </header>
</div>

{% stylesheet %}
  .ts-chrome{position:sticky;top:0;z-index:20;background:#fafaf6;font-family:inherit}.ts-marquee{overflow:hidden;border-bottom:1px solid #dfe3dc;background:#16231d;color:#c8e54a}.ts-marquee__track{display:flex;align-items:center;width:max-content;min-height:28px;gap:13px;padding-right:13px;white-space:nowrap;animation:ts-marquee 26s linear infinite}.ts-marquee span{font-size:.62rem;font-weight:850;letter-spacing:.13em}.ts-marquee i{font-style:normal;font-size:.55rem}.ts-header{border-bottom:1px solid #e2e5dd;background:rgba(250,250,246,.96);backdrop-filter:blur(12px)}.ts-header__inner{display:grid;grid-template-columns:1fr auto 1fr;width:min(1220px,calc(100% - 32px));min-height:64px;margin:auto;align-items:center;color:#16231d}.ts-header a{color:inherit;text-decoration:none;font-size:.84rem;font-weight:750}.ts-header nav{display:flex;gap:28px}.ts-header nav a:first-child{border-bottom:1px solid #16231d;padding-bottom:4px}.ts-header__catalog{justify-self:end}.ts-header__catalog span{color:#79971e;font-size:1rem}@keyframes ts-marquee{to{transform:translateX(-50%)}}@media(prefers-reduced-motion:reduce){.ts-marquee__track{animation:none}}@media(max-width:650px){.ts-header__inner{grid-template-columns:1fr auto}.ts-header nav{display:none}.ts-header__catalog{font-size:.76rem}.ts-marquee__track{animation-duration:20s}}
{% endstylesheet %}

{% schema %}
{"name":"Navegación tienda","tag":"section","class":"section-tienda-header","settings":[]}
{% endschema %}
