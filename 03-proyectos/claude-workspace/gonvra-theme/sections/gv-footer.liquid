{%- if section.settings.wave -%}
  {% render 'gv-wave', from: section.settings.wave_from, fill: '#101a16', accent: '#c8e54a', uid: section.id %}
{%- endif -%}
<footer class="gvft">
  <div class="gvft-wrap">
    <div class="gvft-top">
      <div class="gvft-brand">
        <p class="gvft-logo">{{ section.settings.brand_text }}</p>
        {% if section.settings.tagline != blank %}<p class="gvft-tag">{{ section.settings.tagline }}</p>{% endif %}
        {% if shop.enabled_payment_types != blank %}
          <div class="gvft-pays" aria-label="Medios de pago">
            {% if section.settings.show_mp %}<img class="gvft-pay gvft-pay--mp" src="{{ 'gv-pay-mp.png' | asset_url }}" width="40" height="26" loading="lazy" alt="Mercado Pago">{% endif %}
            {% for type in shop.enabled_payment_types %}{{ type | payment_type_svg_tag: class: 'gvft-pay' }}{% endfor %}
          </div>
        {% endif %}
      </div>

      <div class="gvft-cols">
        {% for block in section.blocks %}
          {% if block.type == 'columna' %}
            <div {{ block.shopify_attributes }}>
              <strong>{{ block.settings.title }}</strong>
              {% assign items = block.settings.links | newline_to_br | split: '<br />' %}
              <ul>
                {% for item in items %}
                  {% assign parts = item | strip | split: '::' %}
                  {% if parts[0] != blank %}
                    <li><a href="{{ parts[1] | default: '#' | strip }}">{{ parts[0] | strip }}</a></li>
                  {% endif %}
                {% endfor %}
              </ul>
            </div>
          {% endif %}
        {% endfor %}

        {% if section.settings.show_news %}
          <div class="gvft-news">
            <strong>{{ section.settings.news_title }}</strong>
            <p>{{ section.settings.news_text }}</p>
            {% form 'customer' %}
              <input type="hidden" name="contact[tags]" value="newsletter">
              <div class="gvft-news__row">
                <input type="email" name="contact[email]" placeholder="tu@email.com" aria-label="Tu email" required>
                <button type="submit" aria-label="Suscribirme">→</button>
              </div>
              {% if form.posted_successfully? %}<small class="gvft-ok">¡Listo! Te vamos a escribir.</small>{% endif %}
            {% endform %}
          </div>
        {% endif %}
      </div>
    </div>

    <div class="gvft-legal">
      <small>© {{ 'now' | date: '%Y' }} {{ section.settings.brand_text }}. {{ section.settings.legal }}</small>
      <small>{{ section.settings.legal_2 }}</small>
    </div>
  </div>
</footer>

{% if section.settings.wa_number != blank %}
  <div class="gvwa" data-gvwa data-endpoint="{{ section.settings.ia_endpoint }}">
    <div class="gvwa-chat" data-gvwa-chat hidden role="dialog" aria-label="{{ section.settings.ia_title | escape }}">
      <div class="gvwa-head">
        <div class="gvwa-head__id">
          <span class="gvwa-avatar" aria-hidden="true">
            <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.6l1.9 4.7 4.7 1.9-4.7 1.9L12 15.8l-1.9-4.7L5.4 9.2l4.7-1.9L12 2.6ZM18.5 14l.9 2.2 2.2.9-2.2.9-.9 2.2-.9-2.2-2.2-.9 2.2-.9.9-2.2Z"/></svg>
          </span>
          <div>
            <strong>{{ section.settings.ia_title }}</strong>
            <small>{{ section.settings.ia_sub }}</small>
          </div>
        </div>
        <button type="button" data-gvwa-close aria-label="Cerrar">×</button>
      </div>

      <div class="gvwa-log" data-gvwa-log aria-live="polite"></div>

      <div class="gvwa-chips" data-gvwa-chips>
        {% for block in section.blocks %}
          {% if block.type == 'consulta' %}
            <button type="button" data-q="{{ block.settings.q | escape }}" data-claves="{{ block.settings.claves | escape }}" data-a="{{ block.settings.a | strip_html | strip | escape }}" {{ block.shopify_attributes }}>{{ block.settings.q }}</button>
          {% endif %}
        {% endfor %}
      </div>

      <form class="gvwa-form" data-gvwa-form autocomplete="off">
        <input type="text" name="q" placeholder="{{ section.settings.ia_placeholder }}" aria-label="Escribí tu consulta">
        <button type="submit" aria-label="Enviar">→</button>
      </form>

      <a class="gvwa-humano" href="https://wa.me/{{ section.settings.wa_number }}?text={{ section.settings.wa_text | url_encode }}" target="_blank" rel="noopener">{{ section.settings.ia_humano }}</a>
    </div>

    <div class="gvwa-fabs">
      <button class="gvwa-fab gvwa-fab--ia" type="button" data-gvwa-toggle aria-expanded="false" aria-label="{{ section.settings.ia_title | escape }}">
        <svg class="gvwa-i1" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2.6l1.9 4.7 4.7 1.9-4.7 1.9L12 15.8l-1.9-4.7L5.4 9.2l4.7-1.9L12 2.6ZM18.5 14l.9 2.2 2.2.9-2.2.9-.9 2.2-.9-2.2-2.2-.9 2.2-.9.9-2.2Z"/></svg>
        <svg class="gvwa-i2" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" aria-hidden="true"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
      <a class="gvwa-fab gvwa-fab--wa" href="https://wa.me/{{ section.settings.wa_number }}?text={{ section.settings.wa_text | url_encode }}" target="_blank" rel="noopener" aria-label="Escribinos por WhatsApp">
        <svg viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M12 2a10 10 0 0 0-8.6 15L2 22l5.2-1.4A10 10 0 1 0 12 2Zm5.8 14.2c-.3.7-1.5 1.3-2.1 1.4-.6.1-1.3.1-2.1-.1-.5-.2-1.1-.4-1.9-.7-3.3-1.4-5.4-4.7-5.6-5-.2-.2-1.3-1.7-1.3-3.3 0-1.6.8-2.3 1.1-2.7.3-.3.6-.4.8-.4h.6c.2 0 .5-.1.7.5l1 2.4c.1.2.1.4 0 .6l-.4.6-.3.4c-.1.1-.3.3-.1.6.2.3.8 1.3 1.7 2.1 1.2 1 2.2 1.4 2.5 1.5.3.1.5.1.7-.1l.9-1c.2-.2.4-.2.6-.1l2.2 1.1c.3.1.5.2.6.3.1.2.1.7-.2 1.4Z"/></svg>
      </a>
    </div>
  </div>
{% endif %}

{% stylesheet %}
.gvw{position:relative;line-height:0;margin-bottom:-2px;overflow:hidden}
.gvw-svg{display:block;width:100%;height:clamp(52px,7vw,110px)}
.gvw-p{will-change:transform}
.gvw-p1{opacity:.34;animation:gvw-slide 19s linear infinite}
.gvw-p2{opacity:.55;animation:gvw-slide 13s linear infinite reverse}
.gvw-p3{animation:gvw-slide 26s linear infinite}
@keyframes gvw-slide{from{transform:translateX(0)}to{transform:translateX(-1440px)}}
@media (prefers-reduced-motion:reduce){.gvw-p{animation:none}}

.gvft{background:#101a16;color:#eceee7;font-family:inherit}
.gvft-wrap{width:min(1280px,calc(100% - 36px));margin:auto;padding:clamp(44px,5vw,72px) 0 26px}
.gvft-top{display:grid;grid-template-columns:1fr 1.35fr;gap:clamp(28px,5vw,72px)}
.gvft-logo{margin:0;font-size:1.15rem;font-weight:850;letter-spacing:.34em;text-transform:uppercase}
.gvft-tag{max-width:34ch;margin:14px 0 0;color:#9aa79a;font-size:.87rem;line-height:1.6}
.gvft-pays{display:flex;flex-wrap:wrap;gap:7px;margin:20px 0 0}
.gvft-pay{width:40px;height:26px;border-radius:5px}
.gvft-pay--mp{padding:3px 4px;background:#fff;object-fit:contain}
.gvft-cols{display:grid;grid-template-columns:repeat(3,1fr);gap:clamp(18px,3vw,40px)}
.gvft-cols strong{display:block;margin:0 0 13px;font-size:.72rem;font-weight:800;letter-spacing:.14em;text-transform:uppercase;color:#c8e54a}
.gvft-cols ul{display:grid;gap:9px;margin:0;padding:0;list-style:none}
.gvft-cols a{color:#c3ccc1;font-size:.85rem;text-decoration:none;transition:color .18s}
.gvft-cols a:hover{color:#fff}
.gvft-news p{margin:0 0 13px;color:#9aa79a;font-size:.82rem;line-height:1.55}
.gvft-news__row{display:flex;gap:7px}
.gvft-news input{flex:1;min-width:0;padding:12px 13px;border:1px solid #2c3a33;border-radius:9px;background:#16221c;color:#eceee7;font:inherit;font-size:.85rem}
.gvft-news input::placeholder{color:#6e7c6f}
.gvft-news button{width:44px;border:0;border-radius:9px;background:#c8e54a;color:#1b2410;font-size:1rem;font-weight:800;cursor:pointer}
.gvft-ok{display:block;margin-top:8px;color:#c8e54a;font-size:.75rem}
.gvft-legal{display:flex;flex-wrap:wrap;justify-content:space-between;gap:10px;margin:clamp(34px,4vw,54px) 0 0;padding-top:20px;border-top:1px solid #2a3830;color:#76846f;font-size:.72rem;line-height:1.5}
.gvwa{position:fixed;right:16px;bottom:20px;z-index:60;display:grid;justify-items:end;gap:12px;font-family:inherit}
.gvwa-fabs{display:grid;gap:10px;justify-items:center}
.gvwa-fab{position:relative;display:grid;width:54px;height:54px;place-items:center;border:0;border-radius:50%;cursor:pointer;text-decoration:none;transition:transform .2s}
.gvwa-fab:hover{transform:scale(1.07)}
.gvwa-fab--ia{background:#101a16;color:#c8e54a;box-shadow:0 12px 28px rgba(16,26,22,.34)}
.gvwa-fab--wa{background:#25d366;color:#fff;box-shadow:0 12px 28px rgba(37,211,102,.38)}
.gvwa-fab svg{width:28px;height:28px}
.gvwa-fab--ia svg{position:absolute;transition:opacity .2s,transform .2s}
.gvwa-i2{width:21px!important;height:21px!important;opacity:0;transform:rotate(-90deg)}
.gvwa-fab--ia[aria-expanded="true"] .gvwa-i1{opacity:0;transform:rotate(90deg)}
.gvwa-fab--ia[aria-expanded="true"] .gvwa-i2{opacity:1;transform:none}
.gvwa-chat[hidden]{display:none!important}
.gvwa-chat{display:flex;flex-direction:column;width:min(360px,calc(100vw - 32px));max-height:min(78vh,620px);border-radius:22px;background:#fff;box-shadow:0 30px 70px rgba(16,26,22,.3);overflow:hidden;animation:gvwa-in .26s cubic-bezier(.2,.7,.3,1) both}
@keyframes gvwa-in{from{opacity:0;transform:translateY(16px) scale(.97)}to{opacity:1;transform:none}}
.gvwa-head{display:flex;align-items:center;justify-content:space-between;gap:12px;padding:15px 16px;background:#101a16;color:#fff}
.gvwa-head__id{display:flex;align-items:center;gap:11px}
.gvwa-avatar{display:grid;width:36px;height:36px;flex:0 0 36px;place-items:center;border-radius:50%;background:#c8e54a;color:#1d2708}
.gvwa-avatar svg{width:20px;height:20px}
.gvwa-head strong{display:block;font-size:.92rem}
.gvwa-head small{display:block;color:#a3ae9f;font-size:.72rem}
.gvwa-head button{width:28px;height:28px;flex:0 0 28px;border:0;border-radius:50%;background:rgba(255,255,255,.13);color:#fff;font-size:1.2rem;line-height:1;cursor:pointer}
.gvwa-log{flex:1;min-height:90px;overflow-y:auto;padding:16px 16px 4px;background:#f7f8f4}
.gvwa-msg{max-width:84%;margin-bottom:10px;padding:11px 14px;border-radius:16px;font-size:.85rem;line-height:1.5;animation:gvwa-msg .3s ease both}
@keyframes gvwa-msg{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.gvwa-msg--bot{background:#fff;color:#101a16;border:1px solid #e6e9e0;border-bottom-left-radius:5px}
.gvwa-msg--yo{margin-left:auto;background:#101a16;color:#fff;border-bottom-right-radius:5px}
.gvwa-esc{display:inline-flex;gap:4px;padding:13px 15px}
.gvwa-esc i{width:6px;height:6px;border-radius:50%;background:#9aa79a;animation:gvwa-bl 1.1s infinite}
.gvwa-esc i:nth-child(2){animation-delay:.15s}
.gvwa-esc i:nth-child(3){animation-delay:.3s}
@keyframes gvwa-bl{0%,60%,100%{opacity:.3}30%{opacity:1}}
.gvwa-chips{display:flex;flex-wrap:wrap;gap:6px;padding:10px 16px 4px;background:#f7f8f4}
.gvwa-chips button{padding:8px 12px;border:1px solid #d8ddcd;border-radius:999px;background:#fff;color:#3d5210;font:inherit;font-size:.75rem;font-weight:600;cursor:pointer;transition:background .18s,transform .18s}
.gvwa-chips button:hover{background:#eef6df;transform:translateY(-1px)}
.gvwa-form{display:flex;gap:8px;padding:12px 16px;border-top:1px solid #e9ece3;background:#fff}
.gvwa-form input{flex:1;min-width:0;padding:11px 13px;border:1px solid #dfe2da;border-radius:11px;font:inherit;font-size:.85rem}
.gvwa-form button{width:42px;border:0;border-radius:11px;background:#101a16;color:#fff;font-size:1.1rem;cursor:pointer}
.gvwa-humano{display:block;padding:0 16px 14px;background:#fff;color:#25a049;font-size:.75rem;font-weight:650;text-align:center;text-decoration:none}
@media(max-width:600px){.gvwa{right:12px;bottom:16px}.gvwa-fab{width:50px;height:50px}.gvwa-chat{max-height:72vh}}
@media(max-width:860px){
.gvft-wrap{width:min(100% - 24px,1280px)}
.gvft-top{grid-template-columns:1fr;gap:32px}
.gvft-cols{grid-template-columns:1fr 1fr}
.gvft-news{grid-column:1/-1}
.gvft-wa{bottom:86px;width:46px;height:46px}
}
{% endstylesheet %}


{% javascript %}
(() => {
  const raiz = document.querySelector('[data-gvwa]');
  if (!raiz) return;
  const chat = raiz.querySelector('[data-gvwa-chat]');
  const boton = raiz.querySelector('[data-gvwa-toggle]');
  const cerrar = raiz.querySelector('[data-gvwa-close]');
  const log = raiz.querySelector('[data-gvwa-log]');
  const chips = Array.prototype.slice.call(raiz.querySelectorAll('[data-gvwa-chips] button'));
  const form = raiz.querySelector('[data-gvwa-form]');
  const endpoint = (raiz.dataset.endpoint || '').trim();
  let arrancado = false;

  const normal = (t) => (t || '').toLowerCase().normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '').replace(/[^a-z0-9 ]/g, ' ').replace(/\s+/g, ' ').trim();

  const base = chips.map((c) => ({
    q: c.dataset.q,
    a: c.dataset.a,
    palabras: normal(c.dataset.q + ' ' + (c.dataset.claves || '')).split(' ').filter((w) => w.length > 3)
  }));

  const escribir = (texto, quien) => {
    const d = document.createElement('div');
    d.className = 'gvwa-msg gvwa-msg--' + quien;
    d.textContent = texto;
    log.appendChild(d);
    log.scrollTop = log.scrollHeight;
  };

  const pensando = () => {
    const d = document.createElement('div');
    d.className = 'gvwa-msg gvwa-msg--bot gvwa-esc';
    d.innerHTML = '<i></i><i></i><i></i>';
    log.appendChild(d);
    log.scrollTop = log.scrollHeight;
    return d;
  };

  const local = (texto) => {
    const t = normal(texto);
    let mejor = null, punta = 0;
    base.forEach((item) => {
      let n = 0;
      item.palabras.forEach((w) => { if (t.indexOf(w) !== -1) n += 2; });
      if (n > punta) { punta = n; mejor = item; }
    });
    return (punta >= 2 && mejor) ? mejor.a
      : 'Esa no la tengo respondida acá. Tocá el enlace verde de abajo y te contesto yo por WhatsApp.';
  };

  const responder = (texto) => {
    const p = pensando();
    if (endpoint) {
      fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ mensaje: texto }) })
        .then((r) => r.json())
        .then((d) => { p.remove(); escribir(d.respuesta || local(texto), 'bot'); })
        .catch(() => { p.remove(); escribir(local(texto), 'bot'); });
    } else {
      setTimeout(() => { p.remove(); escribir(local(texto), 'bot'); }, 420 + Math.random() * 320);
    }
  };

  const abrir = (v) => {
    boton.setAttribute('aria-expanded', String(v));
    chat.hidden = !v;
    if (v && !arrancado) {
      arrancado = true;
      setTimeout(() => escribir('Hola! Preguntame lo que quieras sobre la rasuradora, el envío o el pago.', 'bot'), 220);
    }
  };

  abrir(false);
  boton.addEventListener('click', () => abrir(chat.hidden));
  if (cerrar) cerrar.addEventListener('click', () => abrir(false));
  document.addEventListener('keydown', (e) => { if (e.key === 'Escape' && !chat.hidden) abrir(false); });

  chips.forEach((c) => c.addEventListener('click', () => {
    escribir(c.dataset.q, 'yo');
    const p = pensando();
    setTimeout(() => { p.remove(); escribir(c.dataset.a, 'bot'); }, 380);
  }));

  form.addEventListener('submit', (e) => {
    e.preventDefault();
    const campo = form.querySelector('input');
    const texto = campo.value.trim();
    if (!texto) return;
    escribir(texto, 'yo');
    campo.value = '';
    responder(texto);
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "GONVRA · Pie",
  "tag": "footer",
  "class": "section-gv-footer",
  "settings": [
    { "type": "checkbox", "id": "wave", "label": "Ola arriba del pie", "default": true },
    { "type": "color", "id": "wave_from", "label": "Color de la sección de arriba", "default": "#f7f6f1" },
    { "type": "checkbox", "id": "show_mp", "label": "Sumar el logo de Mercado Pago", "default": true },
    { "type": "text", "id": "brand_text", "label": "Marca", "default": "GONVRA" },
    { "type": "text", "id": "tagline", "label": "Frase", "default": "Cuidado personal sin vueltas: productos elegidos, precio claro y envío con seguimiento a todo el país." },
    { "type": "header", "content": "Newsletter" },
    { "type": "checkbox", "id": "show_news", "label": "Mostrar suscripción", "default": true },
    { "type": "text", "id": "news_title", "label": "Título", "default": "Novedades" },
    { "type": "text", "id": "news_text", "label": "Texto", "default": "Dejanos tu mail y te avisamos cuando sumamos productos nuevos." },
    { "type": "header", "content": "WhatsApp" },
    { "type": "text", "id": "wa_number", "label": "Número (con código de país, sin +)", "info": "Ej: 5491122334455. Dejalo vacío para ocultar el botón." },
    { "type": "text", "id": "wa_text", "label": "Mensaje inicial", "default": "Hola! Tengo una consulta sobre la rasuradora" },
    { "type": "header", "content": "Chat de la tienda" },
    { "type": "text", "id": "ia_title", "label": "Nombre del asistente", "default": "Asistente GONVRA" },
    { "type": "text", "id": "ia_sub", "label": "Bajada", "default": "Te respondo al toque" },
    { "type": "text", "id": "ia_placeholder", "label": "Texto del campo", "default": "Escribí tu consulta…" },
    { "type": "text", "id": "ia_humano", "label": "Link a WhatsApp", "default": "¿Preferís hablar con una persona? Escribime por WhatsApp" },
    { "type": "text", "id": "ia_endpoint", "label": "URL del servidor de IA (opcional)", "info": "Vacío = responde con las preguntas cargadas abajo." },
    { "type": "text", "id": "wa_title", "label": "Título del panel", "default": "¿Te ayudo con algo?" },
    { "type": "text", "id": "wa_sub", "label": "Bajada del panel", "default": "Mirá si tu duda está acá. Si no, escribime." },
    { "type": "text", "id": "wa_cta", "label": "Botón del panel", "default": "Seguir por WhatsApp" },
    { "type": "text", "id": "wa_horario", "label": "Horario", "default": "Respondo de 9 a 21 h" },
    { "type": "header", "content": "Legales" },
    { "type": "text", "id": "legal", "label": "Línea 1", "default": "Todos los derechos reservados." },
    { "type": "text", "id": "legal_2", "label": "Línea 2", "default": "Defensa de las y los consumidores: para reclamos ingresá a argentina.gob.ar/produccion/defensadelconsumidor" }
  ],
  "blocks": [
    {
      "type": "consulta",
      "name": "Pregunta del panel",
      "settings": [
        { "type": "text", "id": "q", "label": "Pregunta", "default": "¿Cuánto tarda en llegar?" },
        { "type": "richtext", "id": "a", "label": "Respuesta", "default": "<p>Respondé acá.</p>" },
        { "type": "text", "id": "claves", "label": "Palabras clave", "info": "Separadas por espacio: envio demora tarda…" }
      ]
    },
    {
      "type": "columna",
      "name": "Columna de links",
      "settings": [
        { "type": "text", "id": "title", "label": "Título", "default": "Tienda" },
        { "type": "textarea", "id": "links", "label": "Links", "info": "Uno por línea, con el formato: Texto::/url", "default": "Inicio::/" }
      ]
    }
  ],
  "presets": [
    {
      "name": "GONVRA · Pie",
      "blocks": [
        { "type": "columna", "settings": { "title": "Tienda", "links": "Inicio::/\nCatálogo::/collections/all\nCarrito::/cart" } },
        { "type": "columna", "settings": { "title": "Ayuda", "links": "Preguntas frecuentes::/#faq\nEnvíos y entrega::/policies/shipping-policy\nCambios y devoluciones::/policies/refund-policy" } },
        { "type": "columna", "settings": { "title": "Legal", "links": "Términos del servicio::/policies/terms-of-service\nPolítica de privacidad::/policies/privacy-policy\nContacto::/pages/contact" } }
      ]
    }
  ]
}
{% endschema %}
