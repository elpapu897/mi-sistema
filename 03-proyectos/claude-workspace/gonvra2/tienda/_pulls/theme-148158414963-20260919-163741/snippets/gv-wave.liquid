{%- comment -%}
  Ola animada de transición entre secciones.
  Parámetros: from (color de la sección de arriba), fill (color de esta sección), uid
{%- endcomment -%}
<div class="gvw" style="background:{{ from }}" aria-hidden="true">
  <svg class="gvw-svg" viewBox="0 0 1440 140" preserveAspectRatio="none" role="presentation">
    <defs>
      <linearGradient id="gvw-{{ uid }}" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0%" stop-color="{{ fill }}"/>
        <stop offset="52%" stop-color="{{ accent | default: '#c8e54a' }}"/>
        <stop offset="100%" stop-color="{{ fill }}"/>
      </linearGradient>
    </defs>
    <path class="gvw-p gvw-p1" fill="url(#gvw-{{ uid }})" d="M0,54 q90,-34 180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 L2880,140 L0,140 Z"/>
    <path class="gvw-p gvw-p2" fill="url(#gvw-{{ uid }})" d="M0,66 q90,-26 180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 L2880,140 L0,140 Z"/>
    <rect x="0" y="126" width="2880" height="24" fill="{{ fill }}"/>
    <path class="gvw-p gvw-p3" fill="{{ fill }}" d="M0,78 q90,-30 180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 t180,0 L2880,140 L0,140 Z"/>
  </svg>
</div>
