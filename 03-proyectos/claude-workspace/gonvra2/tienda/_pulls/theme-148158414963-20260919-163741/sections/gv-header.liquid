<div class="gvn" data-gvn>
  {% if section.settings.show_marquee %}
    <div class="gvn-bar" aria-label="Novedades">
      <div class="gvn-bar__track">
        {% for i in (1..2) %}
          {% for block in section.blocks %}
            {% if block.type == 'anuncio' %}
              <span {% if i == 2 %}aria-hidden="true"{% endif %}>{{ block.settings.text }}</span><i aria-hidden="true">✦</i>
            {% endif %}
          {% endfor %}
        {% endfor %}
      </div>
    </div>
  {% endif %}

  <header class="gvn-head">
    <div class="gvn-head__in">
      <a class="gvn-logo" href="{{ routes.root_url }}" aria-label="{{ shop.name | escape }}">
        {% if section.settings.logo != blank %}
          {{ section.settings.logo | image_url: width: 320 | image_tag: widths: '160, 320', loading: 'eager', alt: shop.name, class: 'gvn-logo__img' }}
        {% else %}
          <span>{{ section.settings.brand_text }}</span>
        {% endif %}
      </a>

      <nav class="gvn-nav" aria-label="Navegación principal">
        {% for block in section.blocks %}
          {% if block.type == 'link' %}
            <a href="{{ block.settings.url | default: routes.root_url }}" {{ block.shopify_attributes }}>{{ block.settings.label }}</a>
          {% endif %}
        {% endfor %}
      </nav>

      <div class="gvn-actions">
        {% if section.settings.cta_label != blank %}
          <a class="gvn-cta" href="{{ section.settings.cta_url | default: routes.root_url }}">{{ section.settings.cta_label }}</a>
        {% endif %}
        <a class="gvn-cart" href="{{ routes.cart_url }}" aria-label="Carrito">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M6 8h12l-1 12H7L6 8Z"/><path d="M9 8V6a3 3 0 0 1 6 0v2"/></svg>
          <b data-gvn-count>{{ cart.item_count }}</b>
        </a>
        <button class="gvn-burger" type="button" data-gvn-burger aria-label="Abrir menú" aria-expanded="false"><span></span><span></span></button>
      </div>
    </div>

    <div class="gvn-drawer" data-gvn-drawer hidden>
      {% for block in section.blocks %}
        {% if block.type == 'link' %}
          <a href="{{ block.settings.url | default: routes.root_url }}">{{ block.settings.label }}</a>
        {% endif %}
      {% endfor %}
      {% if section.settings.cta_label != blank %}
        <a class="gvn-drawer__cta" href="{{ section.settings.cta_url | default: routes.root_url }}">{{ section.settings.cta_label }}</a>
      {% endif %}
    </div>
  </header>
</div>

{% stylesheet %}
:root{color-scheme:light}
html,body{background:#f7f6f1}
img,video,picture{forced-color-adjust:none}
.gvn{position:sticky;top:0;z-index:50;font-family:inherit;background:#f7f6f1}
.gvn-bar{overflow:hidden;background:#101a16;color:#c8e54a}
.gvn-bar__track{display:flex;align-items:center;width:max-content;gap:14px;padding-right:14px;min-height:30px;white-space:nowrap;font-size:.68rem;font-weight:750;letter-spacing:.14em;text-transform:uppercase;animation:gvn-run 30s linear infinite}
.gvn-bar__track i{font-style:normal;opacity:.5}
@keyframes gvn-run{from{transform:translateX(0)}to{transform:translateX(-50%)}}
.gvn-head{border-bottom:1px solid #e2e5dd;background:rgba(247,246,241,.92);backdrop-filter:blur(9px)}
.gvn-head__in{display:grid;grid-template-columns:1fr auto 1fr;align-items:center;gap:18px;width:min(1280px,calc(100% - 36px));margin:auto;padding:13px 0}
.gvn-logo{justify-self:start;color:#101a16;text-decoration:none;font-size:1.02rem;font-weight:850;letter-spacing:.3em;text-transform:uppercase}
.gvn-logo__img{display:block;width:auto;max-height:26px}
.gvn-nav{display:flex;justify-content:center;gap:24px}
.gvn-nav a{position:relative;color:#101a16;font-size:.83rem;font-weight:600;text-decoration:none}
.gvn-nav a::after{content:"";position:absolute;bottom:-4px;left:0;width:0;height:1.5px;background:#101a16;transition:width .22s}
.gvn-nav a:hover::after{width:100%}
.gvn-actions{display:flex;justify-self:end;align-items:center;gap:12px}
.gvn-cta{padding:10px 18px;border-radius:9px;background:#101a16;color:#fff;font-size:.72rem;font-weight:800;letter-spacing:.1em;text-transform:uppercase;text-decoration:none;white-space:nowrap}
.gvn-cart{position:relative;display:grid;place-items:center;width:36px;height:36px;color:#101a16}
.gvn-cart svg{width:21px;height:21px}
.gvn-cart b{position:absolute;top:0;right:0;display:grid;min-width:17px;height:17px;place-items:center;padding:0 4px;border-radius:99px;background:#c8e54a;color:#1d2708;font-size:.6rem;font-weight:850}
.gvn-burger{display:none;width:36px;height:36px;padding:0;border:0;background:none;cursor:pointer}
.gvn-burger span{display:block;width:20px;height:1.8px;margin:4px auto;background:#101a16;transition:transform .22s,opacity .22s}
.gvn-burger[aria-expanded="true"] span:first-child{transform:translateY(3px) rotate(45deg)}
.gvn-burger[aria-expanded="true"] span:last-child{transform:translateY(-3px) rotate(-45deg)}
.gvn-drawer[hidden]{display:none!important}
.gvn-drawer{display:grid;gap:2px;padding:8px 18px 18px;border-top:1px solid #e2e5dd;background:#f7f6f1}
.gvn-drawer a{padding:12px 0;border-bottom:1px solid #e8eae2;color:#101a16;font-size:.95rem;font-weight:650;text-decoration:none}
.gvn-drawer__cta{margin-top:12px;padding:15px!important;border:0!important;border-radius:10px;background:#101a16;color:#fff!important;font-size:.78rem!important;font-weight:850!important;letter-spacing:.12em;text-transform:uppercase;text-align:center}
@media(max-width:860px){
.gvn-head__in{grid-template-columns:1fr auto;width:min(100% - 24px,1280px)}
.gvn-nav{display:none}
.gvn-cta{display:none}
.gvn-burger{display:block}
}
@media(min-width:861px){.gvn-drawer{display:none!important}}
{% endstylesheet %}

{% javascript %}
(() => {
  const root = document.querySelector('[data-gvn]');
  if (!root) return;
  const burger = root.querySelector('[data-gvn-burger]');
  const drawer = root.querySelector('[data-gvn-drawer]');
  if (burger && drawer) {
    drawer.hidden = true;
    burger.addEventListener('click', () => {
      const open = burger.getAttribute('aria-expanded') === 'true';
      burger.setAttribute('aria-expanded', String(!open));
      drawer.hidden = open;
    });
  }
  document.addEventListener('cart:updated', () => {
    fetch('/cart.js').then((r) => r.json()).then((c) => {
      const b = root.querySelector('[data-gvn-count]');
      if (b) b.textContent = c.item_count;
    }).catch(() => {});
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "GONVRA · Cabecera",
  "tag": "header",
  "class": "section-gv-header",
  "settings": [
    { "type": "image_picker", "id": "logo", "label": "Logo" },
    { "type": "text", "id": "brand_text", "label": "Texto si no hay logo", "default": "GONVRA" },
    { "type": "checkbox", "id": "show_marquee", "label": "Mostrar barra animada", "default": true },
    { "type": "text", "id": "cta_label", "label": "Botón", "default": "Comprar" },
    { "type": "url", "id": "cta_url", "label": "Link del botón" }
  ],
  "blocks": [
    {
      "type": "anuncio",
      "name": "Anuncio",
      "settings": [{ "type": "text", "id": "text", "label": "Texto", "default": "Envío a todo el país" }]
    },
    {
      "type": "link",
      "name": "Link del menú",
      "settings": [
        { "type": "text", "id": "label", "label": "Texto", "default": "Inicio" },
        { "type": "url", "id": "url", "label": "Destino" }
      ]
    }
  ],
  "presets": [
    {
      "name": "GONVRA · Cabecera",
      "blocks": [
        { "type": "anuncio", "settings": { "text": "Envío a todo el país con seguimiento" } },
        { "type": "anuncio", "settings": { "text": "Rostro + cuerpo · un solo equipo" } },
        { "type": "anuncio", "settings": { "text": "Pago protegido con Shopify" } },
        { "type": "link", "settings": { "label": "Inicio" } },
        { "type": "link", "settings": { "label": "Catálogo" } },
        { "type": "link", "settings": { "label": "Preguntas" } }
      ]
    }
  ]
}
{% endschema %}
