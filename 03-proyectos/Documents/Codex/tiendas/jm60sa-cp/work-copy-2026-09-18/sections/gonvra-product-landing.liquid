{% liquid
  assign current_variant = product.selected_or_first_available_variant
  assign has_stock = current_variant.available
%}

<section class="gv-product" data-gv-product="{{ section.id }}">
  <header class="gv-topbar">
    <div class="gv-topbar__inner">
      <a class="gv-brand" href="{{ routes.root_url }}" aria-label="GONVRA">
        <img src="{{ 'gonvra-wordmark.svg' | asset_url }}" alt="GONVRA" width="190" height="40" loading="eager">
      </a>
      <p>Grooming esencial</p>
    </div>
  </header>

  <div class="gv-hero">
    <img class="gv-hero__image" src="{{ 'gonvra-hero.webp' | asset_url }}" alt="Rasuradora integral recargable GONVRA en un baño luminoso" width="1664" height="936" loading="eager">
    <div class="gv-hero__veil"></div>
    <div class="gv-hero__copy">
      <p class="gv-kicker">GONVRA / Cuidado personal</p>
      <h1>Tu rutina de recorte, más simple.</h1>
      <p>Rostro, cuerpo y los largos que elegís. Una herramienta compacta, recargable y lista para acompañar tu día.</p>
      <a class="gv-link" href="#comprar">Ver opciones <span aria-hidden="true">↓</span></a>
    </div>
  </div>

  <main class="gv-shell" id="comprar">
    <div class="gv-product-grid">
      <div class="gv-gallery" aria-label="Galería de producto">
        {% for media in product.media limit: 3 %}
          {% if media.media_type == 'image' %}
            <figure class="gv-gallery__tile">
              {{ media.preview_image | image_url: width: 900 | image_tag: widths: '360, 540, 720, 900', sizes: '(min-width: 990px) 34vw, 86vw', loading: 'lazy', alt: product.title }}
            </figure>
          {% endif %}
        {% endfor %}
      </div>

      <aside class="gv-buy" data-gv-buy>
        <p class="gv-kicker">Una sola herramienta. Varios retoques.</p>
        <h2>{{ product.title | escape }}</h2>
        <p class="gv-price">{{ current_variant.price | money }}</p>
        <p class="gv-intro">Elegí cuántas unidades querés llevar. La variante disponible es negro y verde lima.</p>

        <div class="gv-units" role="group" aria-label="Elegí unidades">
          <button class="gv-unit is-selected" type="button" data-gv-unit="1" aria-pressed="true">
            <span><strong>Individual</strong><small>1 unidad</small></span><b>Elegir</b>
          </button>
          <button class="gv-unit" type="button" data-gv-unit="2" aria-pressed="false">
            <span><strong>Dúo</strong><small>2 unidades</small></span><b>Elegir</b>
          </button>
        </div>

        <ul class="gv-checks" role="list">
          <li>Peines guía de 1, 3 y 5 mm</li>
          <li>Recargable por USB</li>
          <li>Rostro y vello corporal</li>
        </ul>

        {% form 'product', product, class: 'gv-form' %}
          <input type="hidden" name="id" value="{{ current_variant.id }}">
          <input type="hidden" name="quantity" value="1" data-gv-quantity>
          {% if has_stock %}
            <p class="gv-stock"><span aria-hidden="true"></span> Disponible para comprar</p>
            <button class="gv-cart" type="submit">Agregar al carrito</button>
          {% else %}
            <p class="gv-stock gv-stock--muted">Sin stock por el momento</p>
            <button class="gv-cart" type="submit" disabled>Sin stock</button>
          {% endif %}
        {% endform %}

        {% if shop.enabled_payment_types != blank %}
          <div class="gv-payments" aria-label="Medios de pago disponibles">
            {% for type in shop.enabled_payment_types %}
              {{ type | payment_type_svg_tag: class: 'gv-payment-icon' }}
            {% endfor %}
          </div>
        {% endif %}

        <div class="gv-progress" aria-label="Etapas del pedido">
          <div><span>1</span><strong>Confirmación</strong><small>Recibís el detalle de tu compra.</small></div>
          <div><span>2</span><strong>Preparación</strong><small>El pedido pasa a gestión.</small></div>
          <div><span>3</span><strong>Seguimiento</strong><small>Consultá el estado una vez enviado.</small></div>
        </div>
      </aside>
    </div>

    <section class="gv-editorial">
      <div><p class="gv-kicker">Hecho para rutinas reales</p><h2>Un recorte que se adapta a vos.</h2></div>
      <p>Usala sin peine para un recorte más cercano o colocá una guía para mantener el largo. Es una rasuradora de recorte: el resultado es temporal y depende del tipo de vello y del uso.</p>
    </section>

    <section class="gv-cards" aria-label="Características">
      <article><span>01</span><h3>Elegí el largo</h3><p>Alterná entre 1, 3 y 5 mm según el acabado que buscás.</p></article>
      <article><span>02</span><h3>Usala en seco</h3><p>Para cuidarla, usala sobre piel limpia y seca. La ficha no certifica uso bajo agua.</p></article>
      <article><span>03</span><h3>Guardala lista</h3><p>Limpiá los restos de vello con el cepillo y recargala con el cable USB.</p></article>
    </section>

    <section class="gv-faq">
      <p class="gv-kicker">Información clara</p>
      <h2>Antes de comprar</h2>
      <details open><summary>¿Qué incluye?</summary><p>Rasuradora, peines guía, cable de carga USB y cepillo de limpieza.</p></details>
      <details><summary>¿Sirve para rostro y cuerpo?</summary><p>Está diseñada para recortar vello de rostro y cuerpo. En zonas sensibles, hacé una prueba en un área pequeña y procedé con cuidado.</p></details>
      <details><summary>¿Puedo elegir otro color?</summary><p>No por ahora. El proveedor tiene vinculada únicamente la versión negro y verde lima, por eso no se muestran variantes que no se puedan despachar.</p></details>
      <details><summary>¿Por qué comprar directo en GONVRA?</summary><p>Ves la configuración concreta del producto antes de comprar. Podés comparar con otros canales, pero revisá siempre precio final, plazo y políticas vigentes.</p></details>
    </section>
  </main>

  <footer class="gv-footer"><img src="{{ 'gonvra-wordmark.svg' | asset_url }}" alt="GONVRA" width="150" height="32" loading="lazy"><p>Rutinas simples. Elecciones claras.</p></footer>
</section>

{% stylesheet %}
  .gv-product { --gv-ink:#0d201a; --gv-paper:#f7f8f2; --gv-lime:#c8e54a; --gv-muted:#68716c; --gv-line:#dce0da; color:var(--gv-ink); background:var(--gv-paper); font-family:inherit; }
  .gv-topbar { position:relative; z-index:2; background:var(--gv-ink); color:#fff; }.gv-topbar__inner { width:min(1220px, calc(100% - 38px)); min-height:64px; margin:auto; display:flex; align-items:center; justify-content:space-between; }.gv-brand img { display:block; width:170px; height:auto; }.gv-topbar p { margin:0; color:#cdd4ce; font-size:.78rem; letter-spacing:.08em; text-transform:uppercase; }
  .gv-hero { position:relative; min-height:620px; display:flex; align-items:end; overflow:hidden; background:#e6e6dd; }.gv-hero__image,.gv-hero__veil { position:absolute; inset:0; width:100%; height:100%; }.gv-hero__image { object-fit:cover; }.gv-hero__veil { background:linear-gradient(90deg, rgba(13,32,26,.76) 0%, rgba(13,32,26,.4) 37%, transparent 68%); }.gv-hero__copy { position:relative; z-index:1; width:min(1220px, calc(100% - 38px)); margin:0 auto; padding:90px 0; color:#fff; }.gv-kicker { margin:0 0 12px; color:#718c20; font-size:.72rem; font-weight:800; letter-spacing:.13em; text-transform:uppercase; }.gv-hero .gv-kicker { color:var(--gv-lime); }.gv-hero h1 { max-width:620px; margin:0; font-size:clamp(3rem, 6vw, 6rem); line-height:.94; letter-spacing:-.065em; }.gv-hero__copy > p:not(.gv-kicker) { max-width:475px; margin:22px 0; color:#e2e7e2; font-size:1.05rem; line-height:1.55; }.gv-link { display:inline-flex; gap:9px; align-items:center; color:#fff; font-weight:800; text-decoration:none; border-bottom:1px solid var(--gv-lime); padding-bottom:6px; }
  .gv-shell { width:min(1220px, calc(100% - 38px)); margin:auto; padding:76px 0; }.gv-product-grid { display:grid; grid-template-columns:minmax(0, 1.22fr) minmax(360px, .78fr); gap:clamp(32px, 7vw, 96px); align-items:start; }.gv-gallery { display:grid; grid-template-columns:1fr 1fr; gap:12px; }.gv-gallery__tile { min-height:240px; margin:0; overflow:hidden; background:#e4e7df; }.gv-gallery__tile:first-child { grid-column:span 2; min-height:480px; }.gv-gallery img { display:block; width:100%; height:100%; object-fit:cover; }
  .gv-buy { position:sticky; top:22px; padding:2px 0; }.gv-buy h2 { margin:0; font-size:clamp(1.85rem, 3vw, 2.8rem); line-height:1.05; letter-spacing:-.045em; }.gv-price { margin:14px 0; font-size:1.25rem; font-weight:800; }.gv-intro { color:var(--gv-muted); line-height:1.55; }.gv-units { display:grid; gap:9px; margin:25px 0 19px; }.gv-unit { display:flex; align-items:center; justify-content:space-between; padding:15px; border:1px solid var(--gv-line); background:#fff; color:var(--gv-ink); text-align:left; cursor:pointer; transition:border .18s ease, background .18s ease; }.gv-unit:hover,.gv-unit.is-selected { border-color:var(--gv-ink); background:#f1f4e7; }.gv-unit span { display:grid; gap:3px; }.gv-unit small { color:var(--gv-muted); }.gv-unit b { color:#5c7611; font-size:.76rem; }.gv-checks { display:grid; gap:9px; padding:0; margin:0 0 22px; list-style:none; color:#3f4c45; font-size:.91rem; }.gv-checks li::before { content:'✓'; color:#759215; font-weight:900; margin-right:9px; }.gv-stock { display:flex; gap:7px; align-items:center; margin:0 0 11px; color:#416420; font-size:.84rem; font-weight:700; }.gv-stock span { width:8px; height:8px; border-radius:50%; background:#76a938; }.gv-stock--muted { color:var(--gv-muted); }.gv-cart { width:100%; border:0; padding:17px; background:var(--gv-ink); color:#fff; font:inherit; font-weight:800; letter-spacing:.08em; text-transform:uppercase; cursor:pointer; transition:background .18s ease, transform .18s ease; }.gv-cart:hover { background:#274b3a; transform:translateY(-1px); }.gv-cart:disabled { cursor:not-allowed; opacity:.5; }.gv-payments { display:flex; flex-wrap:wrap; gap:8px; align-items:center; margin:17px 0; }.gv-payment-icon { width:39px; height:25px; }.gv-progress { display:grid; grid-template-columns:repeat(3, 1fr); gap:8px; padding-top:20px; border-top:1px solid var(--gv-line); }.gv-progress div { display:grid; gap:4px; }.gv-progress span { display:grid; width:21px; height:21px; place-items:center; border-radius:50%; background:var(--gv-lime); font-size:.71rem; font-weight:800; }.gv-progress strong { font-size:.77rem; }.gv-progress small { color:var(--gv-muted); font-size:.69rem; line-height:1.3; }
  .gv-editorial { display:grid; grid-template-columns:.95fr 1.05fr; gap:12vw; margin:120px 0 44px; padding-top:30px; border-top:1px solid var(--gv-ink); }.gv-editorial h2,.gv-faq h2 { margin:0; font-size:clamp(2rem, 4vw, 3.85rem); line-height:1; letter-spacing:-.055em; }.gv-editorial > p { margin:30px 0 0; color:var(--gv-muted); font-size:1.08rem; line-height:1.6; }.gv-cards { display:grid; grid-template-columns:repeat(3, 1fr); border-top:1px solid var(--gv-line); border-bottom:1px solid var(--gv-line); }.gv-cards article { padding:30px 24px 34px; }.gv-cards article + article { border-left:1px solid var(--gv-line); }.gv-cards span { color:#74901f; font-size:.75rem; font-weight:800; }.gv-cards h3 { margin:36px 0 9px; font-size:1.12rem; }.gv-cards p { max-width:270px; margin:0; color:var(--gv-muted); font-size:.91rem; line-height:1.5; }.gv-faq { max-width:850px; margin:120px auto 20px; }.gv-faq > .gv-kicker { margin-bottom:8px; }.gv-faq details { border-top:1px solid var(--gv-line); }.gv-faq details:last-child { border-bottom:1px solid var(--gv-line); }.gv-faq summary { display:flex; justify-content:space-between; gap:16px; padding:19px 0; cursor:pointer; font-weight:750; list-style:none; }.gv-faq summary::-webkit-details-marker { display:none; }.gv-faq summary::after { content:'+'; color:#6e8e18; font-size:1.35rem; }.gv-faq details[open] summary::after { content:'−'; }.gv-faq details p { max-width:700px; margin:-2px 0 20px; color:var(--gv-muted); line-height:1.55; }.gv-footer { display:flex; align-items:center; justify-content:space-between; gap:18px; padding:28px max(19px, calc((100vw - 1220px) / 2)); background:var(--gv-ink); color:#dce3dc; }.gv-footer img { width:138px; height:auto; }.gv-footer p { margin:0; font-size:.8rem; }
  @media (max-width: 820px) { .gv-topbar__inner,.gv-hero__copy,.gv-shell { width:min(100% - 24px, 1220px); }.gv-topbar p { display:none; }.gv-hero { min-height:520px; }.gv-hero__veil { background:linear-gradient(90deg, rgba(13,32,26,.72), rgba(13,32,26,.18)); }.gv-hero__copy { padding:65px 0; }.gv-product-grid,.gv-editorial { grid-template-columns:1fr; }.gv-buy { position:static; }.gv-gallery__tile:first-child { min-height:360px; }.gv-cards { grid-template-columns:1fr; }.gv-cards article + article { border-top:1px solid var(--gv-line); border-left:0; }.gv-editorial { gap:15px; margin-top:76px; }.gv-editorial > p { margin:0; }.gv-faq { margin-top:76px; }.gv-progress { gap:12px; }.gv-footer { padding:24px 16px; }.gv-footer p { text-align:right; } }
{% endstylesheet %}

{% javascript %}
  document.querySelectorAll('[data-gv-buy]').forEach((buybox) => {
    const quantityInput = buybox.querySelector('[data-gv-quantity]');
    buybox.querySelectorAll('[data-gv-unit]').forEach((choice) => {
      choice.addEventListener('click', () => {
        buybox.querySelectorAll('[data-gv-unit]').forEach((item) => {
          item.classList.remove('is-selected');
          item.setAttribute('aria-pressed', 'false');
        });
        choice.classList.add('is-selected');
        choice.setAttribute('aria-pressed', 'true');
        quantityInput.value = choice.dataset.gvUnit;
      });
    });
  });
{% endjavascript %}

