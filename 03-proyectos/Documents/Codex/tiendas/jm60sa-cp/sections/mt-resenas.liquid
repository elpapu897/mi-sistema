{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background }};
  }
  #shopify-section-{{ section.id }} .mt-reviews { background: {{ section.settings.background }}; }
  #shopify-section-{{ section.id }} .mt-reviews__head { text-align: {{ section.settings.text_align }}; }
  #shopify-section-{{ section.id }} .mt-reviews__head .mt-h2 { font-size: clamp(36px, 5vw, {{ section.settings.heading_size }}px); }
  #shopify-section-{{ section.id }} .mt-reviews__head .mt-body { font-size: clamp(15px, 1.35vw, {{ section.settings.body_size }}px); }
  #shopify-section-{{ section.id }} .mt-reviews__track { --mt-marquee-duration: {{ section.settings.speed }}s; }
  #shopify-section-{{ section.id }} .mt-review-card__text { font-size: clamp(17px, 2vw, {{ section.settings.card_text_size }}px); }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} { padding-top: min({{ section.settings.padding_top }}px, 72px); padding-bottom: min({{ section.settings.padding_bottom }}px, 72px); }
  }
{% endstyle %}

<section class="mt-reviews mt-section">
  <div class="mt-container">
    <header class="mt-reviews__head">
      {%- if section.settings.kicker != blank -%}<p class="mt-kicker mt-reveal">{{ section.settings.kicker }}</p>{%- endif -%}
      <h2 class="mt-h2 mt-reveal">{{ section.settings.headline }}</h2>
      {%- if section.settings.body != blank -%}<div class="mt-body mt-reveal">{{ section.settings.body | newline_to_br }}</div>{%- endif -%}
    </header>
    <p class="mt-reviews__hint" aria-hidden="true">Deslizá para recorrer los momentos.</p>
    <div class="mt-reviews__viewport mt-reveal">
      <div class="mt-reviews__track">
        {%- for repetition in (1..2) -%}
          {%- for block in section.blocks -%}
            <article class="mt-review-card{% if repetition == 2 %} mt-review-card--duplicate{% endif %}" {% if repetition == 1 %}{{ block.shopify_attributes }}{% else %}aria-hidden="true"{% endif %}>
              <div class="mt-review-card__tag">{{ block.settings.tag }}</div>
              <p class="mt-review-card__text">{{ block.settings.quote }}</p>
              <div class="mt-review-card__context"><strong>{{ block.settings.source }}</strong><span>{{ block.settings.detail }}</span></div>
            </article>
          {%- endfor -%}
        {%- endfor -%}
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MT – Momentos de uso",
  "tag": "section",
  "max_blocks": 6,
  "settings": [
    { "type": "text", "id": "kicker", "label": "Antetítulo", "default": "UNA HERRAMIENTA, MUCHOS MOMENTOS" },
    { "type": "text", "id": "headline", "label": "Título", "default": "Pensada para el ritmo real." },
    { "type": "textarea", "id": "body", "label": "Texto", "default": "Una solución compacta para cuando necesitás verte prolijo sin frenar el día." },
    { "type": "select", "id": "text_align", "label": "Alineación", "options": [{"value":"left","label":"Izquierda"},{"value":"center","label":"Centro"},{"value":"right","label":"Derecha"}], "default": "left" },
    { "type": "range", "id": "heading_size", "label": "Tamaño del título (px)", "min": 34, "max": 80, "step": 2, "unit": "px", "default": 60 },
    { "type": "range", "id": "body_size", "label": "Tamaño del texto (px)", "min": 14, "max": 24, "step": 1, "unit": "px", "default": 17 },
    { "type": "range", "id": "card_text_size", "label": "Tamaño del texto de tarjetas (px)", "min": 16, "max": 28, "step": 1, "unit": "px", "default": 20 },
    { "type": "range", "id": "speed", "label": "Duración del movimiento en computadora (segundos)", "min": 20, "max": 80, "step": 2, "unit": "s", "default": 46 },
    { "type": "color", "id": "background", "label": "Color de fondo", "default": "#111827" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 112 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 96 }
  ],
  "blocks": [
    {
      "type": "razon",
      "name": "Razón o uso",
      "settings": [
        { "type": "text", "id": "tag", "label": "Etiqueta", "default": "RUTINA DIARIA" },
        { "type": "textarea", "id": "quote", "label": "Momento de uso", "default": "Un repaso rápido antes de salir, sin preparar todo el baño." },
        { "type": "text", "id": "source", "label": "Contexto", "default": "Todos los días" },
        { "type": "text", "id": "detail", "label": "Detalle", "default": "en casa" }
      ]
    }
  ],
  "presets": [{ "name": "MT – Razones en movimiento", "blocks": [{"type":"razon"},{"type":"razon"},{"type":"razon"},{"type":"razon"}] }]
}
{% endschema %}
