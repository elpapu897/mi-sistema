{% style %}
  #shopify-section-{{ section.id }} {
    padding-top: {{ section.settings.padding_top }}px;
    padding-bottom: {{ section.settings.padding_bottom }}px;
    background: {{ section.settings.background }};
  }
  #shopify-section-{{ section.id }} .mt-angles { background-color: {{ section.settings.background }}; }
  #shopify-section-{{ section.id }} .mt-angles__visual { min-height: {{ section.settings.image_height }}px; {% unless section.settings.sticky %}position: relative; top: 0;{% endunless %} }
  #shopify-section-{{ section.id }} .mt-angles__visual img { min-height: {{ section.settings.image_height }}px; }
  #shopify-section-{{ section.id }} .mt-angles__content { text-align: {{ section.settings.text_align }}; }
  #shopify-section-{{ section.id }} .mt-angles__content > .mt-h2 { font-size: clamp(36px, 5vw, {{ section.settings.heading_size }}px); }
  #shopify-section-{{ section.id }} .mt-angles__content > .mt-body { font-size: clamp(15px, 1.35vw, {{ section.settings.body_size }}px); }
  @media (max-width: 990px) {
    #shopify-section-{{ section.id }} .mt-angles__visual,
    #shopify-section-{{ section.id }} .mt-angles__visual img { min-height: min(58vw, 520px); }
  }
  @media (max-width: 749px) {
    #shopify-section-{{ section.id }} { padding-top: min({{ section.settings.padding_top }}px, 72px); padding-bottom: min({{ section.settings.padding_bottom }}px, 72px); }
    #shopify-section-{{ section.id }} .mt-angles__visual,
    #shopify-section-{{ section.id }} .mt-angles__visual img { min-height: min(72vw, 440px); }
  }
{% endstyle %}

<section class="mt-angles mt-section" id="tecnologia">
  <div class="mt-container">
    <div class="mt-angles__layout">
      <div class="mt-angles__visual mt-reveal">
        {%- if section.settings.image != blank -%}
          <img src="{{ section.settings.image | image_url: width: 2000 }}" alt="{{ section.settings.image.alt | default: section.settings.image_alt | escape }}" loading="lazy" width="{{ section.settings.image.width }}" height="{{ section.settings.image.height }}">
        {%- else -%}
          <img src="{{ 'mt-angulos-wide.webp' | asset_url }}" alt="{{ section.settings.image_alt | escape }}" loading="lazy" width="1672" height="941">
        {%- endif -%}
      </div>

      <div class="mt-angles__content">
        {%- if section.settings.kicker != blank -%}<p class="mt-kicker mt-reveal">{{ section.settings.kicker }}</p>{%- endif -%}
        <h2 class="mt-h2 mt-reveal">{{ section.settings.headline }}</h2>
        {%- if section.settings.body != blank -%}<div class="mt-body mt-reveal">{{ section.settings.body | newline_to_br }}</div>{%- endif -%}

        <div class="mt-angle-points mt-stagger">
          {%- for block in section.blocks -%}
            <article class="mt-angle-point mt-reveal" {{ block.shopify_attributes }}>
              <div class="mt-angle-point__top"><strong style="font-size: {{ block.settings.title_size }}px;">{{ block.settings.title }}</strong><span>{{ block.settings.tag }}</span></div>
              <p style="font-size: {{ block.settings.body_size }}px;">{{ block.settings.body | newline_to_br }}</p>
            </article>
          {%- endfor -%}
        </div>

        <div class="mt-stats mt-stagger">
          <div class="mt-stat mt-reveal"><strong data-mt-count="{{ section.settings.stat_1_number }}" data-mt-suffix="{{ section.settings.stat_1_suffix }}">0</strong><span>{{ section.settings.stat_1_label }}</span></div>
          <div class="mt-stat mt-reveal"><strong data-mt-count="{{ section.settings.stat_2_number }}" data-mt-suffix="{{ section.settings.stat_2_suffix }}">0</strong><span>{{ section.settings.stat_2_label }}</span></div>
        </div>
      </div>
    </div>
  </div>
</section>

{% schema %}
{
  "name": "MT – Tecnología",
  "tag": "section",
  "max_blocks": 4,
  "settings": [
    { "type": "image_picker", "id": "image", "label": "Imagen de varios ángulos" },
    { "type": "text", "id": "image_alt", "label": "Descripción accesible de la imagen", "default": "Afeitadora Helio Mini observada desde varios ángulos" },
    { "type": "checkbox", "id": "sticky", "label": "Mantener la imagen fija al recorrer", "default": true },
    { "type": "range", "id": "image_height", "label": "Altura de la imagen (px)", "min": 420, "max": 760, "step": 20, "unit": "px", "default": 520 },
    { "type": "header", "content": "Contenido" },
    { "type": "text", "id": "kicker", "label": "Antetítulo", "default": "DISEÑADA DESDE TODOS LOS ÁNGULOS" },
    { "type": "text", "id": "headline", "label": "Título", "default": "Doble cabezal. Formato compacto." },
    { "type": "textarea", "id": "body", "label": "Texto", "default": "Una arquitectura de doble cabezal dentro de un cuerpo que cabe en la palma. Lista para el baño, el bolso o el próximo viaje." },
    { "type": "select", "id": "text_align", "label": "Alineación", "options": [{"value":"left","label":"Izquierda"},{"value":"center","label":"Centro"},{"value":"right","label":"Derecha"}], "default": "left" },
    { "type": "range", "id": "heading_size", "label": "Tamaño del título (px)", "min": 34, "max": 80, "step": 2, "unit": "px", "default": 58 },
    { "type": "range", "id": "body_size", "label": "Tamaño del texto (px)", "min": 14, "max": 24, "step": 1, "unit": "px", "default": 18 },
    { "type": "header", "content": "Cifras" },
    { "type": "range", "id": "stat_1_number", "label": "Primera cifra", "min": 1, "max": 10, "step": 1, "default": 2 },
    { "type": "text", "id": "stat_1_suffix", "label": "Sufijo de la primera cifra", "default": "×" },
    { "type": "text", "id": "stat_1_label", "label": "Texto de la primera cifra", "default": "cabezales de corte" },
    { "type": "range", "id": "stat_2_number", "label": "Segunda cifra", "min": 1, "max": 10, "step": 1, "default": 2 },
    { "type": "text", "id": "stat_2_suffix", "label": "Sufijo de la segunda cifra", "default": "%" },
    { "type": "text", "id": "stat_2_label", "label": "Texto de la segunda cifra", "default": "colores para elegir" },
    { "type": "header", "content": "Color y espacio" },
    { "type": "color", "id": "background", "label": "Color de fondo", "default": "#080A0F" },
    { "type": "range", "id": "padding_top", "label": "Espacio superior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 120 },
    { "type": "range", "id": "padding_bottom", "label": "Espacio inferior (px)", "min": 0, "max": 160, "step": 8, "unit": "px", "default": 120 }
  ],
  "blocks": [
    {
      "type": "punto",
      "name": "Punto de producto",
      "settings": [
        { "type": "text", "id": "tag", "label": "Etiqueta", "default": "PRECISIÓN" },
        { "type": "text", "id": "title", "label": "Título", "default": "Dos cabezales, un movimiento natural" },
        { "type": "textarea", "id": "body", "label": "Texto", "default": "Dos superficies circulares de corte, dispuestas lado a lado en un cuerpo compacto." },
        { "type": "range", "id": "title_size", "label": "Tamaño del título (px)", "min": 17, "max": 32, "step": 1, "unit": "px", "default": 21 },
        { "type": "range", "id": "body_size", "label": "Tamaño del texto (px)", "min": 13, "max": 21, "step": 1, "unit": "px", "default": 15 }
      ]
    }
  ],
  "presets": [{ "name": "MT – Tecnología en ángulos", "blocks": [{"type":"punto"},{"type":"punto"},{"type":"punto"}] }]
}
{% endschema %}
