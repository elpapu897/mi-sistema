<section class="gvc" data-gvc>
  <div class="gvc-wrap">
    <header class="gvc-head" data-gvc-reveal>
      {% if section.settings.kicker != blank %}<p class="gvc-kicker">{{ section.settings.kicker }}</p>{% endif %}
      {% if section.settings.heading != blank %}<h2>{{ section.settings.heading }}</h2>{% endif %}
      {% if section.settings.sub != blank %}<p class="gvc-sub">{{ section.settings.sub }}</p>{% endif %}
    </header>

    <div class="gvc-table" data-gvc-reveal role="table" aria-label="{{ section.settings.heading | escape }}">
      <div class="gvc-row gvc-row--head" role="row">
        <span role="columnheader">{{ section.settings.col_0 }}</span>
        <span class="gvc-mine" role="columnheader">{{ section.settings.col_1 }}</span>
        <span role="columnheader">{{ section.settings.col_2 }}</span>
      </div>

      {% for block in section.blocks %}
        <div class="gvc-row" role="row" {{ block.shopify_attributes }}>
          <span class="gvc-feat" role="cell">{{ block.settings.feature }}</span>
          <span class="gvc-mine" role="cell">
            {% if block.settings.mine %}
              <i class="gvc-yes" aria-label="Sí"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m5 10.5 3.2 3.2L15 7"/></svg></i>
            {% else %}
              <i class="gvc-no" aria-label="No"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 6l8 8M14 6l-8 8"/></svg></i>
            {% endif %}
            {% if block.settings.mine_note != blank %}<em>{{ block.settings.mine_note }}</em>{% endif %}
          </span>
          <span role="cell">
            {% if block.settings.other %}
              <i class="gvc-yes gvc-yes--soft" aria-label="Sí"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2"><path d="m5 10.5 3.2 3.2L15 7"/></svg></i>
            {% else %}
              <i class="gvc-no" aria-label="No"><svg viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.2"><path d="M6 6l8 8M14 6l-8 8"/></svg></i>
            {% endif %}
            {% if block.settings.other_note != blank %}<em>{{ block.settings.other_note }}</em>{% endif %}
          </span>
        </div>
      {% endfor %}
    </div>

    {% if section.settings.foot != blank %}<p class="gvc-foot" data-gvc-reveal>{{ section.settings.foot }}</p>{% endif %}
  </div>
</section>

{% stylesheet %}
.gvc{background:#f7f6f1;color:#101a16;font-family:inherit}
.gvc-wrap{width:min(1080px,calc(100% - 36px));margin:auto;padding:clamp(52px,6.5vw,90px) 0}
.gvc-head{max-width:60ch;margin:0 auto;text-align:center}
.gvc-kicker{margin:0 0 11px;color:#6d8b1c;font-size:.68rem;font-weight:850;letter-spacing:.16em;text-transform:uppercase}
.gvc-head h2{margin:0;font-size:clamp(1.7rem,3.4vw,2.9rem);line-height:1.05;letter-spacing:-.035em}
.gvc-sub{margin:14px 0 0;color:#6b7570;font-size:.95rem;line-height:1.6}
.gvc-table{margin:clamp(30px,4vw,52px) 0 0;border:1px solid #e2e5dd;border-radius:16px;background:#fff;overflow:hidden}
.gvc-row{display:grid;grid-template-columns:1.35fr .85fr .8fr;align-items:center;gap:10px;padding:15px 18px;border-top:1px solid #eceee7;transition:background .25s}
.gvc-row:not(.gvc-row--head):hover{background:#f8faf3}
.gvc-table.is-in .gvc-row:not(.gvc-row--head){animation:gvc-fila .55s ease both}
.gvc-table.is-in .gvc-row:nth-child(2){animation-delay:.05s}.gvc-table.is-in .gvc-row:nth-child(3){animation-delay:.11s}.gvc-table.is-in .gvc-row:nth-child(4){animation-delay:.17s}.gvc-table.is-in .gvc-row:nth-child(5){animation-delay:.23s}.gvc-table.is-in .gvc-row:nth-child(6){animation-delay:.29s}.gvc-table.is-in .gvc-row:nth-child(7){animation-delay:.35s}
@keyframes gvc-fila{from{opacity:0;transform:translateX(-14px)}to{opacity:1;transform:none}}
@media (prefers-reduced-motion:reduce){.gvc-table.is-in .gvc-row{animation:none}}
.gvc-row:first-child{border-top:0}
.gvc-row--head{padding:16px 18px;background:#f2f3ed;font-size:.72rem;font-weight:850;letter-spacing:.09em;text-transform:uppercase}
.gvc-row--head span{color:#6b7570}
.gvc-row--head .gvc-mine{color:#101a16}
.gvc-row>span{display:grid;justify-items:center;gap:4px;text-align:center}
.gvc-feat{justify-items:start!important;text-align:left!important;font-size:.9rem;line-height:1.35}
.gvc-mine{position:relative;border-radius:10px}
.gvc-row:not(.gvc-row--head) .gvc-mine{background:#101a16;color:#fff;padding:10px 6px}
.gvc-row em{font-style:normal;font-size:.7rem;line-height:1.3;opacity:.75}
.gvc-yes,.gvc-no{display:grid;width:24px;height:24px;place-items:center;border-radius:50%}
.gvc-yes svg,.gvc-no svg{width:15px;height:15px}
.gvc-yes{background:#c8e54a;color:#1d2708}
.gvc-yes--soft{background:#e6e9e0;color:#5e6a5c}
.gvc-no{background:#eceee7;color:#9aa397}
.gvc-row:not(.gvc-row--head) .gvc-mine .gvc-no{background:#2a3830;color:#7f8c80}
.gvc-foot{margin:20px 0 0;color:#8a938a;font-size:.72rem;line-height:1.5;text-align:center}
.gvc [data-gvc-reveal]{opacity:0;transform:translateY(22px);transition:opacity .7s ease,transform .7s ease}
.gvc [data-gvc-reveal].is-in{opacity:1;transform:none}
@media(max-width:640px){
.gvc-wrap{width:min(100% - 20px,1080px)}
.gvc-row{grid-template-columns:1.2fr .6fr .6fr;padding:13px 12px;gap:6px}
.gvc-feat{font-size:.82rem}
.gvc-row--head{font-size:.62rem}
.gvc-row em{display:none}
}
{% endstylesheet %}

{% javascript %}
(() => {
  document.querySelectorAll('[data-gvc]').forEach((root) => {
    const io = new IntersectionObserver((entries) => {
      entries.forEach((e) => { if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); } });
    }, { threshold: .12 });
    root.querySelectorAll('[data-gvc-reveal]').forEach((el) => io.observe(el));
  });
})();
{% endjavascript %}

{% schema %}
{
  "name": "GONVRA · Comparativa",
  "tag": "section",
  "class": "section-gv-comparativa",
  "settings": [
    { "type": "text", "id": "kicker", "label": "Bajada corta", "default": "Comparación honesta" },
    { "type": "text", "id": "heading", "label": "Título", "default": "Esta rasuradora vs. una máquina común" },
    { "type": "text", "id": "sub", "label": "Bajada", "default": "Comparamos características del producto, no marcas. Fijate si te sirve antes de comprar." },
    { "type": "text", "id": "col_0", "label": "Columna 1", "default": "Característica" },
    { "type": "text", "id": "col_1", "label": "Columna 2", "default": "Rasuradora integral" },
    { "type": "text", "id": "col_2", "label": "Columna 3", "default": "Máquina común" },
    { "type": "text", "id": "foot", "label": "Nota al pie", "default": "Comparación basada en las características declaradas del producto. No incluye marcas específicas." }
  ],
  "blocks": [
    {
      "type": "fila",
      "name": "Fila",
      "settings": [
        { "type": "text", "id": "feature", "label": "Característica", "default": "Sirve para rostro y cuerpo" },
        { "type": "checkbox", "id": "mine", "label": "La tiene esta rasuradora", "default": true },
        { "type": "text", "id": "mine_note", "label": "Nota columna 2" },
        { "type": "checkbox", "id": "other", "label": "La tiene la alternativa", "default": false },
        { "type": "text", "id": "other_note", "label": "Nota columna 3" }
      ]
    }
  ],
  "presets": [
    {
      "name": "GONVRA · Comparativa",
      "blocks": [
        { "type": "fila", "settings": { "feature": "Rostro y cuerpo con el mismo equipo", "mine": true, "other": false } },
        { "type": "fila", "settings": { "feature": "Peines de 1, 3 y 5 mm incluidos", "mine": true, "mine_note": "3 largos", "other": false } },
        { "type": "fila", "settings": { "feature": "Carga por USB", "mine": true, "other": false, "other_note": "Suele ser a pila" } },
        { "type": "fila", "settings": { "feature": "Uso en seco, sin espuma", "mine": true, "other": true } },
        { "type": "fila", "settings": { "feature": "Cabezal reemplazable", "mine": true, "other": false } },
        { "type": "fila", "settings": { "feature": "Tamaño de viaje", "mine": true, "other": false } }
      ]
    }
  ]
}
{% endschema %}
